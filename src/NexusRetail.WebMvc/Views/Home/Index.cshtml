@using NexusRetail.Shared.DTOs.SanPham
@using NexusRetail.Shared.DTOs.Common
@model PagedResultDto<SanPhamDto>

@{
  ViewData["Title"] = "Sản phẩm";
  var prices = new (string? K, string T)[] { 
      (null, "Tất cả mức giá"), 
      ("lt20", "Dưới 20 triệu"), 
      ("mid", "20–30 triệu"), 
      ("gt30", "Trên 30 triệu") 
  };
}

<main class="wrap">
  <aside>
    <section>
      <h4>Khoảng giá</h4>
      @foreach (var (k, t) in prices)
      {
        <a class="opt" asp-action="Index" asp-route-page="1">@t</a>
      }
    </section>
  </aside>

  <div>
    <div id="products" class="grid">
      @foreach (var p in Model.Items)
      {
        <article class="card" data-id="@p.MaSp">
          <div class="img" style="background-image: url('@Url.Content("~/images/products/" + (p.Anh ?? "default.jpg"))')"></div>
          <div class="cb">
            <h3>@p.TenSp</h3>
            <span class="tag">@p.GhiChu</span>
            <div class="price">@p.GiaBan.ToString("N0") đ</div>
            <div style="display: flex; gap: 8px; margin-top: 10px;">
              <button class="btn ghost" type="button" style="flex: 1;">Xem nhanh</button>
              <button class="btn" type="button" onclick="quickAddToCart(event, '@p.MaSp')" title="Thêm vào giỏ" style="padding: 0 14px; background: var(--soft); color: var(--ac); font-weight: 700; border-radius: 10px;">🛒</button>
            </div>
          </div>
        </article>
      }

      @if (!Model.Items.Any()) 
      { 
        <div class="empty" style="grid-column:1/-1">Không có sản phẩm phù hợp.</div> 
      }
    </div>

    @if (Model.TotalPages > 1)
    {
      <div id="pagination" class="pg">
        <a class="@(Model.Page <= 1 ? "off" : "")" 
           asp-action="Index" 
           asp-route-page="@(Model.Page - 1)">←</a>

        @for (var i = 1; i <= Model.TotalPages; i++)
        {
          <a class="@(i == Model.Page ? "on" : "")" 
             asp-action="Index" 
             asp-route-page="@i">@i</a>
        }

        <a class="@(Model.Page >= Model.TotalPages ? "off" : "")" 
           asp-action="Index" 
           asp-route-page="@(Model.Page + 1)">→</a>
      </div>
    }
  </div>
</main>
