@using NexusRetail.Shared.DTOs.SanPham
@using NexusRetail.Shared.DTOs.Common
@model PagedResultDto<SanPhamDto>

@{
    ViewData["Title"] = "Trang chủ — Hệ thống điện thoại chính hãng";
    var prices = new (string? K, string T)[] { 
        (null, "Tất cả mức giá"), 
        ("lt20", "Dưới 20 triệu"), 
        ("mid", "20 – 30 triệu"), 
        ("gt30", "Trên 30 triệu") 
    };
    var currentPrice = ViewBag.CurrentPrice as string;
    var currentBrand = ViewBag.CurrentBrand as string;
    var currentQuery = ViewBag.CurrentQ as string ?? Context.Request.Query["q"].ToString();
    var hasActiveFilters = !string.IsNullOrEmpty(currentPrice) || !string.IsNullOrEmpty(currentBrand) || !string.IsNullOrEmpty(currentQuery);
}

<div class="container py-3">
    <!-- 1. HERO BANNER SECTION (MINIMALIST MODERN) -->
    <section class="dm-hero">
        <div class="row align-items-center g-4">
            <!-- Left Info -->
            <div class="col-lg-7">
                <div class="dm-hero-badge">
                    Hệ thống bán lẻ thiết bị di động chính hãng
                </div>
                <h1 class="dm-hero-title">
                    Công nghệ đỉnh cao.<br/>Trải nghiệm tinh tế.
                </h1>
                <p class="dm-hero-desc">
                    Tuyển tập smartphone cao cấp từ Apple, Samsung, Xiaomi với tiêu chuẩn chính hãng VNA, bảo hành toàn diện 1 đổi 1 và trợ lý AI Gemini tư vấn cấu hình chuẩn xác 24/7.
                </p>
                
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="#productCatalog" class="btn btn-primary btn-lg rounded-3 fw-bold px-4 shadow-sm">
                        Khám phá sản phẩm
                    </a>
                    <a asp-action="TraCuu" class="btn btn-light btn-lg rounded-3 fw-bold px-4 border text-dark">
                        Tra cứu đơn & bảo hành
                    </a>
                </div>

                <div class="d-flex align-items-center gap-4 pt-3 border-top border-secondary border-opacity-10 small text-secondary">
                    <div><strong class="text-dark">100%</strong> Chính hãng VNA</div>
                    <div>•</div>
                    <div><strong class="text-dark">30 Ngày</strong> 1 đổi 1 lỗi NSX</div>
                    <div>•</div>
                    <div><strong class="text-dark">Miễn phí</strong> Giao hàng toàn quốc</div>
                </div>
            </div>

            <!-- Right AI Advisor Box -->
            <div class="col-lg-5">
                <div class="dm-hero-ai-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="dm-logo-icon">AI</div>
                        <div>
                            <h5 class="fw-bold m-0 text-white">Trợ lý AI Duy Mobile</h5>
                            <small class="text-white-50">Tư vấn thông minh theo ngân sách & nhu cầu</small>
                        </div>
                    </div>
                    <p class="small text-white-50 mb-3">
                        Gợi ý nhanh câu hỏi tư vấn cấu hình cùng mô hình Google Gemini:
                    </p>
                    <div class="d-flex flex-column gap-2 mb-3">
                        <button type="button" class="dm-ai-chip text-start" onclick="askAiWithPrompt('Tư vấn điện thoại chụp ảnh đẹp dưới 20 triệu')">
                            Tư vấn điện thoại chụp ảnh đẹp dưới 20 triệu
                        </button>
                        <button type="button" class="dm-ai-chip text-start" onclick="askAiWithPrompt('Điện thoại nào chơi game mượt pin trâu nhất?')">
                            Điện thoại chơi game mượt, pin bền nhất hiện nay
                        </button>
                        <button type="button" class="dm-ai-chip text-start" onclick="askAiWithPrompt('So sánh iPhone 15 Pro Max và Samsung Galaxy S24 Ultra')">
                            So sánh iPhone 15 Pro Max & Samsung S24 Ultra
                        </button>
                    </div>
                    <button type="button" class="btn btn-light w-100 py-2.5 rounded-3 fw-bold text-dark shadow-sm" onclick="openChat()">
                        Mở trợ lý AI tư vấn ngay
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. TRUST BENEFITS STRIP (MINIMALIST) -->
    <section class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="row g-3 text-center text-md-start">
            <div class="col-md-3 col-6 border-end-md">
                <div class="fw-bold text-dark fs-6">Chính hãng 100%</div>
                <small class="text-secondary">Bảo hành tại TTBH ủy quyền VNA</small>
            </div>
            <div class="col-md-3 col-6 border-end-md">
                <div class="fw-bold text-dark fs-6">Đổi trả 30 ngày</div>
                <small class="text-secondary">1 đổi 1 miễn phí lỗi phần cứng</small>
            </div>
            <div class="col-md-3 col-6 border-end-md">
                <div class="fw-bold text-dark fs-6">Giao hàng miễn phí</div>
                <small class="text-secondary">Kiểm tra máy trước khi thanh toán</small>
            </div>
            <div class="col-md-3 col-6">
                <div class="fw-bold text-dark fs-6">Trả góp 0%</div>
                <small class="text-secondary">Thủ tục xét duyệt online 5 phút</small>
            </div>
        </div>
    </section>

    <!-- 3. MAIN CATALOG SECTION -->
    <div class="row g-4" id="productCatalog">
        <!-- Sidebar Filter -->
        <aside class="col-lg-3">
            <div class="dm-filter-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0 text-dark"><i class="bi bi-funnel-fill text-primary me-2"></i> Bộ lọc</h5>
                    @if (hasActiveFilters)
                    {
                        <a asp-action="Index" asp-fragment="productCatalog" class="badge bg-danger-subtle text-danger text-decoration-none py-2 px-2 fw-bold" data-reset-filter="true">
                            Xóa lọc ✕
                        </a>
                    }
                </div>

                @if (!string.IsNullOrEmpty(currentQuery))
                {
                    <div class="p-2 bg-light rounded-3 mb-3 small text-secondary">
                        Từ khóa: <strong class="text-dark">"@currentQuery"</strong>
                    </div>
                }

                @if (!string.IsNullOrEmpty(currentBrand))
                {
                    <div class="p-2 bg-light rounded-3 mb-3 small text-secondary">
                        Thương hiệu: <strong class="text-primary">@currentBrand</strong>
                    </div>
                }

                <!-- Khoảng giá -->
                <div class="mb-4">
                    <div class="dm-filter-heading">Mức giá đề xuất</div>
                    <div class="d-flex flex-column">
                        @foreach (var (k, t) in prices)
                        {
                            var isSelected = (k == null && string.IsNullOrEmpty(currentPrice)) || (k != null && k == currentPrice);
                            <a class="dm-filter-opt @(isSelected ? "active" : "")"
                               data-price="@(k ?? "")"
                               asp-action="Index" 
                               asp-route-page="1"
                               asp-route-price="@k"
                               asp-route-q="@currentQuery"
                               asp-route-brand="@currentBrand"
                               asp-fragment="productCatalog">
                                <span><i class="bi bi-circle-fill me-2 fs-6 opacity-50"></i> @t</span>
                                @if (isSelected)
                                {
                                    <i class="bi bi-check2 text-primary fw-bold"></i>
                                }
                            </a>
                        }
                    </div>
                </div>

                <!-- Cam kết dịch vụ -->
                <div class="pt-3 border-top">
                    <div class="dm-filter-heading">Cam kết Duy Mobile</div>
                    <ul class="list-unstyled small text-secondary mb-0 lh-lg">
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Nguyên seal, mới 100%</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Xuất hóa đơn VAT đầy đủ</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Hỗ trợ thu cũ trợ giá cao</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Cài đặt máy miễn phí</li>
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Product Grid Area -->
        <div class="col-lg-9" id="productCatalogResults">
            <partial name="_ProductCatalogPartial" model="Model" />
        </div>
    </div>
</div>
