@using NexusRetail.Shared.DTOs.SanPham
@using NexusRetail.Shared.DTOs.Common
@model PagedResultDto<SanPhamDto>

@{
    ViewData["Title"] = "Trang chủ — Hệ thống điện thoại chính hãng";
    var prices = new (string? K, string T)[] { 
        (null, "Tất cả mức giá"), 
        ("lt20", "Dưới 20 triệu"), 
        ("mid", "20 – 30 triệu"), 
        ("gt30", "Trên 30 triệu") 
    };
    var currentPrice = ViewBag.CurrentPrice as string;
    var currentBrand = ViewBag.CurrentBrand as string;
    var currentQuery = ViewBag.CurrentQ as string ?? Context.Request.Query["q"].ToString();
    var hasActiveFilters = !string.IsNullOrEmpty(currentPrice) || !string.IsNullOrEmpty(currentBrand) || !string.IsNullOrEmpty(currentQuery);
}

<div class="container py-3">
    <!-- 1. HERO BANNER SECTION -->
    <section class="dm-hero">
        <div class="row align-items-center g-4">
            <!-- Left Info -->
            <div class="col-lg-7">
                <div class="dm-hero-badge">
                    <i class="bi bi-stars"></i> Nền tảng bán lẻ công nghệ thế hệ mới 2026
                </div>
                <h1 class="dm-hero-title">
                    Đón đầu công nghệ.<br/>Khẳng định chất riêng.
                </h1>
                <p class="dm-hero-desc">
                    Khám phá những siêu phẩm smartphone mới nhất từ Apple, Samsung, Xiaomi với cam kết 100% chính hãng VNA, bảo hành toàn diện và trải nghiệm trợ lý AI thông minh 24/7.
                </p>
                
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="#productCatalog" class="btn btn-primary btn-lg rounded-3 fw-bold px-4 shadow">
                        Khám phá sản phẩm ngay <i class="bi bi-arrow-down-short ms-1"></i>
                    </a>
                    <a asp-action="TraCuu" class="btn btn-light btn-lg rounded-3 fw-bold px-4 border text-dark">
                        <i class="bi bi-search me-1"></i> Tra cứu đơn hàng
                    </a>
                </div>

                <div class="d-flex align-items-center gap-4 pt-3 border-top border-primary border-opacity-25">
                    <div>
                        <div class="fs-4 fw-bolder text-dark">100%</div>
                        <div class="small text-secondary">Chính hãng VNA</div>
                    </div>
                    <div class="text-secondary opacity-25">/</div>
                    <div>
                        <div class="fs-4 fw-bolder text-dark">30 Ngày</div>
                        <div class="small text-secondary">1 đổi 1 miễn phí</div>
                    </div>
                    <div class="text-secondary opacity-25">/</div>
                    <div>
                        <div class="fs-4 fw-bolder text-dark">2 Giờ</div>
                        <div class="small text-secondary">Giao hàng siêu tốc</div>
                    </div>
                </div>
            </div>

            <!-- Right AI Advisor Box -->
            <div class="col-lg-5">
                <div class="dm-hero-ai-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="dm-logo-icon">
                            <i class="bi bi-robot"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold m-0 text-dark">Trợ lý AI Duy Mobile</h5>
                            <small class="text-secondary">Tư vấn chuẩn xác theo nhu cầu & túi tiền</small>
                        </div>
                    </div>
                    <p class="small text-secondary mb-3">
                        Bạn đang phân vân giữa iPhone hay Samsung? Hãy hỏi ngay trợ lý AI được tích hợp trực tiếp:
                    </p>
                    <div class="d-flex flex-column gap-2 mb-3">
                        <button type="button" class="dm-ai-chip" onclick="askAiWithPrompt('Tư vấn điện thoại chụp ảnh đẹp dưới 20 triệu')">
                            📸 Chụp ảnh đẹp dưới 20 triệu
                        </button>
                        <button type="button" class="dm-ai-chip" onclick="askAiWithPrompt('Điện thoại nào chơi game mượt pin trâu nhất?')">
                            🎮 Chơi game mượt, pin trâu
                        </button>
                        <button type="button" class="dm-ai-chip" onclick="askAiWithPrompt('So sánh iPhone 16 Plus và Samsung S24 Ultra')">
                            ⚖️ So sánh iPhone 16 Plus & S24 Ultra
                        </button>
                    </div>
                    <button type="button" class="btn btn-dark w-100 py-2 rounded-3 fw-bold shadow-sm" onclick="openChat()">
                        <i class="bi bi-chat-dots-fill me-2 text-warning"></i> Trò chuyện với AI ngay →
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. TRUST BENEFITS STRIP -->
    <section class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="dm-trust-card">
                <div class="dm-trust-icon"><i class="bi bi-truck"></i></div>
                <div>
                    <h6 class="fw-bold m-0 text-dark">Giao hàng 2H</h6>
                    <small class="text-secondary">Miễn phí toàn quốc</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="dm-trust-card">
                <div class="dm-trust-icon"><i class="bi bi-arrow-repeat"></i></div>
                <div>
                    <h6 class="fw-bold m-0 text-dark">30 Ngày 1 đổi 1</h6>
                    <small class="text-secondary">Lỗi phần cứng NSX</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="dm-trust-card">
                <div class="dm-trust-icon"><i class="bi bi-credit-card-2-front"></i></div>
                <div>
                    <h6 class="fw-bold m-0 text-dark">Trả góp 0%</h6>
                    <small class="text-secondary">Thủ tục nhanh 5 phút</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="dm-trust-card">
                <div class="dm-trust-icon"><i class="bi bi-shield-check"></i></div>
                <div>
                    <h6 class="fw-bold m-0 text-dark">100% Chính hãng</h6>
                    <small class="text-secondary">Bảo hành tại TTBH ủy quyền</small>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. MAIN CATALOG SECTION -->
    <div class="row g-4" id="productCatalog">
        <!-- Sidebar Filter -->
        <aside class="col-lg-3">
            <div class="dm-filter-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0 text-dark"><i class="bi bi-funnel-fill text-primary me-2"></i> Bộ lọc</h5>
                    @if (hasActiveFilters)
                    {
                        <a asp-action="Index" asp-fragment="productCatalog" class="badge bg-danger-subtle text-danger text-decoration-none py-2 px-2 fw-bold">
                            Xóa lọc ✕
                        </a>
                    }
                </div>

                @if (!string.IsNullOrEmpty(currentQuery))
                {
                    <div class="p-2 bg-light rounded-3 mb-3 small text-secondary">
                        Từ khóa: <strong class="text-dark">"@currentQuery"</strong>
                    </div>
                }

                @if (!string.IsNullOrEmpty(currentBrand))
                {
                    <div class="p-2 bg-light rounded-3 mb-3 small text-secondary">
                        Thương hiệu: <strong class="text-primary">@currentBrand</strong>
                    </div>
                }

                <!-- Khoảng giá -->
                <div class="mb-4">
                    <div class="dm-filter-heading">Mức giá đề xuất</div>
                    <div class="d-flex flex-column">
                        @foreach (var (k, t) in prices)
                        {
                            var isSelected = (k == null && string.IsNullOrEmpty(currentPrice)) || (k != null && k == currentPrice);
                            <a class="dm-filter-opt @(isSelected ? "active" : "")" 
                               asp-action="Index" 
                               asp-route-page="1"
                               asp-route-price="@k"
                               asp-route-q="@currentQuery"
                               asp-route-brand="@currentBrand"
                               asp-fragment="productCatalog">
                                <span><i class="bi bi-circle-fill me-2 fs-6 opacity-50"></i> @t</span>
                                @if (isSelected)
                                {
                                    <i class="bi bi-check2 text-primary fw-bold"></i>
                                }
                            </a>
                        }
                    </div>
                </div>

                <!-- Cam kết dịch vụ -->
                <div class="pt-3 border-top">
                    <div class="dm-filter-heading">Cam kết Duy Mobile</div>
                    <ul class="list-unstyled small text-secondary mb-0 lh-lg">
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Nguyên seal, mới 100%</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Xuất hóa đơn VAT đầy đủ</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Hỗ trợ thu cũ trợ giá cao</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1"></i> Cài đặt máy miễn phí</li>
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Product Grid Area -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold m-0 text-dark" id="productCountHeader">
                    Danh sách sản phẩm (@Model.TotalItems)
                </h4>
                <span class="text-secondary small fw-semibold" id="pageIndicator">
                    Trang @Model.Page / @Math.Max(1, Model.TotalPages)
                </span>
            </div>

            <!-- Product Card Grid -->
            <div class="row g-3" id="productGrid">
                @foreach (var p in Model.Items)
                {
                    var fallbackImg = Url.Content("~/images/products/" + (string.IsNullOrEmpty(p.Anh) ? "iphone_16_plus_black_37a9bceca0.png" : p.Anh));
                    <div class="col-lg-4 col-md-6">
                        <div class="dm-product-card">
                            <div class="dm-product-badge-wrap">
                                @if (p.GiaBan > 25000000)
                                {
                                    <span class="dm-badge dm-badge-flagship"><i class="bi bi-crown-fill text-warning me-1"></i> Flagship</span>
                                }
                                else
                                {
                                    <span class="dm-badge dm-badge-hot"><i class="bi bi-fire text-danger me-1"></i> Bán chạy</span>
                                }
                            </div>

                            <div class="dm-product-img-box" onclick="openProduct('@p.MaSp')">
                                <img src="@fallbackImg" alt="@p.TenSp" onerror="this.src='/images/products/iphone_16_plus_black_37a9bceca0.png';" />
                            </div>

                            <div class="dm-product-body">
                                <div class="dm-product-brand">@(string.IsNullOrEmpty(p.TenNhanHieu) ? "Chính hãng" : p.TenNhanHieu)</div>
                                <h3 class="dm-product-title" onclick="openProduct('@p.MaSp')" title="@p.TenSp">@p.TenSp</h3>
                                
                                <span class="dm-product-tag">
                                    <i class="bi bi-shield-check text-success me-1"></i>
                                    @(string.IsNullOrWhiteSpace(p.GhiChu) ? "Bảo hành 12 tháng VNA" : p.GhiChu)
                                </span>

                                <div class="dm-product-price">@p.GiaBan.ToString("N0") ₫</div>

                                <div class="dm-card-actions">
                                    <button type="button" class="dm-btn-quickview" onclick="openProduct('@p.MaSp')">
                                        <i class="bi bi-eye me-1"></i> Xem nhanh
                                    </button>
                                    <button type="button" class="dm-btn-addcart" onclick="quickAddToCart(event, '@p.MaSp')" title="Thêm vào giỏ">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.Items.Any())
                {
                    <div class="col-12 py-5 text-center">
                        <div class="p-5 bg-white rounded-4 border shadow-sm">
                            <i class="bi bi-search text-secondary fs-1 d-block mb-3"></i>
                            <h4 class="fw-bold text-dark">Không tìm thấy sản phẩm nào phù hợp!</h4>
                            <p class="text-secondary small mb-3">Hãy thử tìm với từ khóa khác hoặc xóa bớt các bộ lọc đang chọn.</p>
                            <a asp-action="Index" class="btn btn-primary rounded-3 fw-bold px-4">
                                Xem tất cả sản phẩm
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div id="paginationArea" class="mt-4">
                @if (Model.TotalPages > 1)
                {
                    <ul class="pagination pagination-md justify-content-center m-0 gap-1">
                        @if (Model.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link rounded-3 fw-bold" 
                                   asp-action="Index" 
                                   asp-route-page="@(Model.Page - 1)"
                                   asp-route-q="@currentQuery"
                                   asp-route-price="@currentPrice"
                                   asp-route-brand="@currentBrand"
                                   asp-fragment="productCatalog">← Trước</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link rounded-3 opacity-50">← Trước</span>
                            </li>
                        }

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link rounded-3 fw-bold" 
                                   asp-action="Index" 
                                   asp-route-page="@i"
                                   asp-route-q="@currentQuery"
                                   asp-route-price="@currentPrice"
                                   asp-route-brand="@currentBrand"
                                   asp-fragment="productCatalog">@i</a>
                            </li>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link rounded-3 fw-bold" 
                                   asp-action="Index" 
                                   asp-route-page="@(Model.Page + 1)"
                                   asp-route-q="@currentQuery"
                                   asp-route-price="@currentPrice"
                                   asp-route-brand="@currentBrand"
                                   asp-fragment="productCatalog">Sau →</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link rounded-3 opacity-50">Sau →</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
