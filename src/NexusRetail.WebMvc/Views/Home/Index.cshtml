@using NexusRetail.Shared.DTOs.SanPham
@using NexusRetail.Shared.DTOs.Common
@model PagedResultDto<SanPhamDto>

@{
    ViewData["Title"] = "Trang chủ — Hệ thống điện thoại chính hãng";
    var prices = new (string? K, string T)[] { 
        (null, "Tất cả mức giá"), 
        ("lt20", "Dưới 20 triệu"), 
        ("mid", "20 – 30 triệu"), 
        ("gt30", "Trên 30 triệu") 
    };
    var currentPrice = ViewBag.CurrentPrice as string;
    var currentBrand = ViewBag.CurrentBrand as string;
    var currentQuery = ViewBag.CurrentQ as string ?? Context.Request.Query["q"].ToString();
    var hasActiveFilters = !string.IsNullOrEmpty(currentPrice) || !string.IsNullOrEmpty(currentBrand) || !string.IsNullOrEmpty(currentQuery);
}

<!-- Hero Banner Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge">✨ Nền tảng bán lẻ công nghệ thế hệ mới</div>
        <h1 class="hero-title">Đón đầu công nghệ.<br/>Khẳng định chất riêng.</h1>
        <p class="hero-subtitle">
            Khám phá những siêu phẩm smartphone mới nhất từ Apple, Samsung, Xiaomi với cam kết 100% chính hãng, bảo hành toàn diện và trải nghiệm trợ lý AI thông minh 24/7.
        </p>
        
        <div class="hero-actions">
            <a href="#products" class="btn hero-cta-btn">Khám phá sản phẩm ngay ↓</a>
            <a asp-action="TraCuu" class="btn ghost hero-secondary-btn">🔍 Tra cứu đơn hàng</a>
        </div>

        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-num">100%</span>
                <span class="stat-text">Chính hãng VNA</span>
            </div>
            <div class="stat-sep">/</div>
            <div class="stat-item">
                <span class="stat-num">30 Ngày</span>
                <span class="stat-text">1 đổi 1 miễn phí</span>
            </div>
            <div class="stat-sep">/</div>
            <div class="stat-item">
                <span class="stat-num">2 Giờ</span>
                <span class="stat-text">Giao hàng siêu tốc</span>
            </div>
        </div>
    </div>

    <!-- AI Advisor Floating Card -->
    <div class="hero-aibox">
        <div class="aibox-header">
            <div class="aibox-avatar">✨</div>
            <div>
                <h4>Trợ lý AI Duy Mobile</h4>
                <p>Tư vấn chuẩn xác theo nhu cầu & túi tiền</p>
            </div>
        </div>
        <p class="aibox-desc">
            Bạn đang phân vân giữa iPhone hay Samsung? Hãy nói cho AI biết tầm giá và nhu cầu sử dụng của bạn:
        </p>
        <div class="aibox-suggestions">
            <button type="button" class="ai-chip" onclick="askAiWithPrompt('Tư vấn điện thoại chụp ảnh đẹp dưới 20 triệu')">📸 Chụp ảnh đẹp dưới 20tr</button>
            <button type="button" class="ai-chip" onclick="askAiWithPrompt('Điện thoại nào chơi game mượt pin trâu nhất?')">🎮 Chơi game pin trâu</button>
            <button type="button" class="ai-chip" onclick="askAiWithPrompt('So sánh iPhone 16 Plus và Samsung S24 Ultra')">⚖️ So sánh iPhone 16 & S24</button>
        </div>
        <button class="btn aibox-btn" id="heroAI">
            Trò chuyện với AI ngay →
        </button>
    </div>
</section>

<!-- Main Products & Filter Section -->
<main class="wrap" id="products">
    <!-- Filter Sidebar -->
    <aside class="sidebar-filter">
        <div class="filter-card">
            <div class="filter-header">
                <h3>Bộ lọc sản phẩm</h3>
                @if (hasActiveFilters)
                {
                    <a asp-action="Index" asp-fragment="products" class="filter-clear">Xóa bộ lọc ✕</a>
                }
            </div>

            @if (!string.IsNullOrEmpty(currentQuery))
            {
                <div class="filter-query-info">
                    <span>Từ khóa: <strong>"@currentQuery"</strong></span>
                </div>
            }

            @if (!string.IsNullOrEmpty(currentBrand))
            {
                <div class="filter-query-info" style="margin-top: 6px;">
                    <span>Mã thương hiệu: <strong>@currentBrand</strong></span>
                </div>
            }

            <section class="filter-group">
                <h4>Khoảng giá đề xuất</h4>
                <div class="price-options">
                    @foreach (var (k, t) in prices)
                    {
                        var isSelected = (k == null && string.IsNullOrEmpty(currentPrice)) || (k != null && k == currentPrice);
                        <a class="opt @(isSelected ? "on" : "")" 
                           asp-action="Index" 
                           asp-route-page="1"
                           asp-route-price="@k"
                           asp-route-q="@currentQuery"
                           asp-route-brand="@currentBrand"
                           asp-fragment="products">
                            <span class="opt-bullet"></span> @t
                        </a>
                    }
                </div>
            </section>

            <section class="filter-group">
                <h4>Cam kết Duy Mobile</h4>
                <ul class="trust-list">
                    <li>✓ 100% Hàng chính hãng phân phối</li>
                    <li>✓ Miễn phí vận chuyển toàn quốc</li>
                    <li>✓ Hỗ trợ trả góp 0% lãi suất</li>
                    <li>✓ Thu cũ đổi mới trợ giá cao</li>
                </ul>
            </section>
        </div>
    </aside>

    <!-- Product Grid Area -->
    <div class="products-area">
        <div class="products-top-info">
            <h2>Danh sách sản phẩm (@Model.TotalItems)</h2>
            <span class="page-indicator">Trang @Model.Page / @Math.Max(1, Model.TotalPages)</span>
        </div>

        <div id="products" class="grid">
            @foreach (var p in Model.Items)
            {
                var fallbackImg = Url.Content("~/images/products/" + (string.IsNullOrEmpty(p.Anh) ? "iphone_16_plus_black_37a9bceca0.png" : p.Anh));
                <article class="card" data-id="@p.MaSp">
                    <div class="card-badges">
                        @if (p.GiaBan > 25000000)
                        {
                            <span class="badge badge-flagship">👑 Flagship</span>
                        }
                        else
                        {
                            <span class="badge badge-hot">🔥 Bán chạy</span>
                        }
                    </div>

                    <div class="img" style="background-image: url('@fallbackImg')" title="@p.TenSp"></div>

                    <div class="cb">
                        <span class="card-brand">@(string.IsNullOrEmpty(p.TenNhanHieu) ? "Chính hãng" : p.TenNhanHieu)</span>
                        <h3 title="@p.TenSp">@p.TenSp</h3>
                        
                        @if (!string.IsNullOrWhiteSpace(p.GhiChu))
                        {
                            <span class="tag">@p.GhiChu</span>
                        }
                        else
                        {
                            <span class="tag">Bảo hành 12 tháng</span>
                        }

                        <div class="price">@p.GiaBan.ToString("N0") ₫</div>

                        <div class="card-actions">
                            <button class="btn ghost quick-view-btn" type="button" title="Xem thông số kỹ thuật chi tiết">Xem nhanh</button>
                            <button class="btn add-cart-btn" type="button" onclick="quickAddToCart(event, '@p.MaSp')" title="Thêm vào giỏ hàng">
                                🛒
                            </button>
                        </div>
                    </div>
                </article>
            }

            @if (!Model.Items.Any()) 
            { 
                <div class="empty-state" style="grid-column: 1 / -1;">
                    <div class="empty-icon">🔍</div>
                    <h3>Không tìm thấy sản phẩm nào phù hợp!</h3>
                    <p>Hãy thử tìm bằng từ khóa khác hoặc xóa bộ lọc để xem toàn bộ danh mục sản phẩm.</p>
                    <a asp-action="Index" class="btn" style="margin-top: 16px;">Xem tất cả sản phẩm</a>
                </div> 
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div id="pagination" class="pg">
                <a class="@(Model.Page <= 1 ? "off" : "")" 
                   asp-action="Index" 
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-q="@currentQuery"
                   asp-route-price="@currentPrice"
                   asp-route-brand="@currentBrand"
                   asp-fragment="products">← Trước</a>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="@(i == Model.Page ? "on" : "")" 
                       asp-action="Index" 
                       asp-route-page="@i"
                       asp-route-q="@currentQuery"
                       asp-route-price="@currentPrice"
                       asp-route-brand="@currentBrand"
                       asp-fragment="products">@i</a>
                }

                <a class="@(Model.Page >= Model.TotalPages ? "off" : "")" 
                   asp-action="Index" 
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-q="@currentQuery"
                   asp-route-price="@currentPrice"
                   asp-route-brand="@currentBrand"
                   asp-fragment="products">Sau →</a>
            </div>
        }
    </div>
</main>

<script>
    function askAiWithPrompt(prompt) {
        const fab = document.getElementById('fab');
        const chatPanel = document.getElementById('chat');
        const input = document.getElementById('ci');
        const sendBtn = document.getElementById('cs');
        
        if (chatPanel) {
            chatPanel.classList.add('open');
            if (input) {
                input.value = prompt;
                input.focus();
                if (sendBtn) {
                    sendBtn.click();
                }
            }
        }
    }
</script>
