@model System.Text.Json.JsonElement?
@{
    ViewData["Title"] = "Tra cứu đơn hàng & Bảo hành";
    var sdt = ViewBag.Sdt as string;
    var hasResult = Model.HasValue && Model.Value.ValueKind == System.Text.Json.JsonValueKind.Array && Model.Value.GetArrayLength() > 0;
}

<div class="wrap" style="max-width: 800px; margin: 30px auto; padding: 0 16px;">
    <div style="background: var(--card); border-radius: var(--r); padding: 32px 24px; box-shadow: var(--sh); border: 1px solid var(--line); margin-bottom: 24px;">
        <h1 style="font-size: 24px; font-weight: 700; color: var(--ink); margin-bottom: 8px;">🔍 Tra cứu đơn hàng & Thời hạn bảo hành</h1>
        <p style="color: var(--mute); font-size: 14px; margin-bottom: 20px;">
            Nhập số điện thoại mua hàng để kiểm tra lịch sử hóa đơn và thời hạn bảo hành của máy.
        </p>

        <form method="get" asp-action="TraCuu" style="display: flex; gap: 12px; max-width: 500px;">
            <input name="sdt" type="tel" value="@sdt" placeholder="Nhập số điện thoại (ví dụ: 0912345678)..." required
                   style="flex: 1; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--line); font-size: 15px; outline: none;" />
            <button type="submit" class="btn" style="padding: 12px 24px; font-weight: 700; border-radius: 12px;">Tra cứu ngay</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(sdt))
    {
        @if (!hasResult)
        {
            <div style="background: var(--card); border-radius: var(--r); padding: 40px 20px; text-align: center; border: 1px solid var(--line);">
                <div style="font-size: 40px; margin-bottom: 12px;">🔎</div>
                <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 6px;">Không tìm thấy đơn hàng nào!</h3>
                <p style="color: var(--mute); font-size: 14px;">Không có hóa đơn mua hàng nào gắn với số điện thoại <strong>@sdt</strong>. Vui lòng kiểm tra lại số điện thoại đã đăng ký khi mua hàng.</p>
            </div>
        }
        else
        {
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: var(--ink);">
                Kết quả tìm kiếm cho số: <span style="color: var(--ac);">@sdt</span> (@(Model!.Value.GetArrayLength()) hóa đơn)
            </h2>

            @foreach (var hd in Model!.Value.EnumerateArray())
            {
                var maHdb = hd.GetProperty("maHdb").GetString();
                var ngayBan = DateTime.Parse(hd.GetProperty("ngayBan").GetString() ?? DateTime.Now.ToString());
                var tongTien = hd.GetProperty("tongTien").GetDecimal();
                var tenKhach = hd.GetProperty("tenKhach").GetString();
                var danhSachMon = hd.GetProperty("danhSachMon");

                <div style="background: var(--card); border-radius: var(--r); padding: 20px; box-shadow: var(--sh); border: 1px solid var(--line); margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 14px;">
                        <div>
                            <span style="font-weight: 800; color: var(--ac); font-size: 16px;">HĐ @maHdb</span>
                            <span style="color: var(--mute); font-size: 13px; margin-left: 8px;">— @ngayBan.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div style="font-weight: 800; font-size: 16px; color: var(--ink);">
                            Tổng: @tongTien.ToString("N0") đ
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var item in danhSachMon.EnumerateArray())
                        {
                            var tenSp = item.GetProperty("tenSp").GetString();
                            var soLuong = item.GetProperty("soLuong").GetInt32();
                            var thanhTien = item.GetProperty("thanhTien").GetDecimal();
                            var hanBh = DateTime.Parse(item.GetProperty("hanBaoHanh").GetString() ?? DateTime.Now.ToString());
                            var conHan = hanBh >= DateTime.Now;

                            <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg); padding: 12px 16px; border-radius: 10px; border: 1px solid var(--line);">
                                <div>
                                    <div style="font-weight: 600; font-size: 14px; color: var(--ink);">@tenSp (x@soLuong)</div>
                                    <div style="font-size: 12px; color: var(--mute); margin-top: 2px;">
                                        Bảo hành đến: <strong>@hanBh.ToString("dd/MM/yyyy")</strong>
                                        @if (conHan)
                                        {
                                            <span style="display: inline-block; background: #dcfce7; color: var(--ok); padding: 2px 8px; border-radius: 4px; font-weight: 700; margin-left: 6px;">Còn hạn bảo hành</span>
                                        }
                                        else
                                        {
                                            <span style="display: inline-block; background: #fee2e2; color: #b91c1c; padding: 2px 8px; border-radius: 4px; font-weight: 700; margin-left: 6px;">Hết hạn bảo hành</span>
                                        }
                                    </div>
                                </div>
                                <div style="font-weight: 700; color: var(--ink); font-size: 14px;">
                                    @thanhTien.ToString("N0") đ
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }
</div>
