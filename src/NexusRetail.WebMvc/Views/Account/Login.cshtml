@model NexusRetail.Shared.DTOs.Auth.LoginDto
@{
    ViewData["Title"] = "Đăng nhập tài khoản";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="row g-0">
                    <!-- Brand Side -->
                    <div class="col-md-5 d-none d-md-flex flex-column justify-content-between p-5 text-white" 
                         style="background: linear-gradient(135deg, #0f172a, #1e1b4b 60%, #312e81);">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 text-white-50 small mb-4">
                                <i class="bi bi-shield-check text-warning"></i> Nền tảng bán lẻ công nghệ 2026
                            </div>
                            <h3 class="fw-bolder mb-3 lh-sm">Trải nghiệm công nghệ đỉnh cao cùng Duy Mobile</h3>
                            <p class="text-white-50 small mb-4">Đăng nhập tài khoản để quản lý đơn hàng, tra cứu bảo hành và nhận tư vấn thông minh từ trợ lý AI.</p>
                            
                            <div class="d-flex flex-column gap-3">
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="rounded-circle bg-white bg-opacity-10 p-2 text-warning fs-5">
                                        <i class="bi bi-shield-lock-fill"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-bold">Bảo hành 1 đổi 1 trong 30 ngày</div>
                                        <div class="text-white-50">Lỗi phần cứng do nhà sản xuất</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="rounded-circle bg-white bg-opacity-10 p-2 text-primary fs-5">
                                        <i class="bi bi-robot"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-bold">Trợ lý AI Gemini 1.5</div>
                                        <div class="text-white-50">Tư vấn chọn máy chuẩn xác 24/7</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="rounded-circle bg-white bg-opacity-10 p-2 text-success fs-5">
                                        <i class="bi bi-truck"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-bold">Giao hàng miễn phí toàn quốc</div>
                                        <div class="text-white-50">Kiểm tra máy trước khi thanh toán</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="small text-white-50 pt-4 border-top border-white border-opacity-10">
                            © 2026 Duy Mobile • Hệ thống bán lẻ ủy quyền
                        </div>
                    </div>

                    <!-- Form Side -->
                    <div class="col-md-7 p-4 p-lg-5 bg-white">
                        <div class="mb-4">
                            <h3 class="fw-bold text-dark mb-1">Đăng nhập</h3>
                            <small class="text-secondary">Nhập thông tin tài khoản của bạn để tiếp tục</small>
                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success rounded-3 small py-2">
                                <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger rounded-3 small py-2">
                                <div asp-validation-summary="All"></div>
                            </div>
                        }

                        <form asp-action="Login" method="post" id="loginForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div class="mb-3">
                                <label asp-for="Username" class="form-label small fw-bold text-dark">Tên đăng nhập hoặc Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-person"></i></span>
                                    <input asp-for="Username" id="loginUsername" class="form-control border-start-0 py-2" placeholder="Nhập tên đăng nhập..." autocomplete="username" autofocus />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="Password" class="form-label small fw-bold text-dark m-0">Mật khẩu</label>
                                    <a href="javascript:void(0)" onclick="alert('Vui lòng liên hệ hotline 1800.6868 hoặc dùng các tài khoản Demo có sẵn phía dưới.');" class="small text-decoration-none">Quên mật khẩu?</a>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" id="loginPassword" type="password" class="form-control border-start-0 border-end-0 py-2" placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                                    <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePwd" title="Ẩn/Hiện">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberCheck" />
                                <label class="form-check-label small text-secondary" for="rememberCheck">
                                    Ghi nhớ đăng nhập trong 7 ngày
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold w-100 py-2 shadow-sm mb-4">
                                Đăng nhập ngay <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </form>

                        <!-- Quick Demo Credentials Box -->
                        <div class="p-3 bg-light rounded-4 border mb-4">
                            <div class="small fw-bold text-secondary mb-2">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Điền nhanh tài khoản kiểm thử (Demo 1-Click):
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-dark rounded-3 px-3 fw-bold" onclick="fillDemo('admin', 'admin123')">
                                    👑 <strong>Admin</strong> (admin / admin123)
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-bold" onclick="fillDemo('khachhang', '123456')">
                                    👤 <strong>Khách hàng</strong> (khachhang / 123456)
                                </button>
                            </div>
                        </div>

                        <div class="text-center small text-secondary">
                            Chưa có tài khoản? <a asp-action="Register" class="fw-bold text-primary text-decoration-none">Đăng ký thành viên mới</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillDemo(username, password) {
            const u = document.getElementById('loginUsername');
            const p = document.getElementById('loginPassword');
            if (u && p) {
                u.value = username;
                p.value = password;
                u.focus();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('togglePwd');
            const pwdInput = document.getElementById('loginPassword');
            if (toggleBtn && pwdInput) {
                toggleBtn.addEventListener('click', () => {
                    if (pwdInput.type === 'password') {
                        pwdInput.type = 'text';
                        toggleBtn.innerHTML = '<i class="bi bi-eye-slash"></i>';
                    } else {
                        pwdInput.type = 'password';
                        toggleBtn.innerHTML = '<i class="bi bi-eye"></i>';
                    }
                });
            }
        });
    </script>
}
