@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="wrap" style="max-width: 600px; margin: 60px auto; padding: 0 16px; text-align: center;">
    <div style="background: var(--card); border-radius: 20px; padding: 48px 24px; box-shadow: var(--sh); border: 1px solid var(--line);">
        <div style="font-size: 54px; margin-bottom: 16px;">🚫</div>
        <h1 style="font-size: 24px; font-weight: 800; color: #ef4444; margin-bottom: 10px;">Truy cập bị từ chối</h1>
        <p style="color: var(--mute); font-size: 15px; margin-bottom: 24px; line-height: 1.6;">
            Bạn không có đủ quyền hạn để truy cập vào khu vực này. Trang này chỉ dành cho tài khoản có quyền Quản trị (Admin) hoặc Nhân viên (Staff).
        </p>
        <div style="display: flex; gap: 12px; justify-content: center;">
            <a asp-controller="Home" asp-action="Index" class="btn">Về trang chủ</a>
            <a asp-controller="Account" asp-action="Login" class="btn ghost">Đăng nhập tài khoản khác</a>
        </div>
    </div>
</div>
