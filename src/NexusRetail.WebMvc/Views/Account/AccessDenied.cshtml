@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div style="max-width: 600px; margin: 60px auto; text-align: center; background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border: 1px solid #fee2e2;">
    <div style="font-size: 56px; margin-bottom: 16px;">🚫</div>
    <h1 style="font-size: 24px; color: #b91c1c; margin-bottom: 12px; font-weight: 700;">Từ chối truy cập (403 Forbidden)</h1>
    <p style="color: #4b5563; font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
        Trang này dành riêng cho tài khoản có vai trò <b>Quản trị viên (Admin)</b>.<br />
        Tài khoản hiện tại của bạn không có quyền truy cập vào khu vực này.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center;">
        <a asp-controller="Home" asp-action="Index" class="btn" style="padding: 10px 20px;">Về trang chủ</a>
        <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn ghost" style="padding: 10px 20px;">Đăng xuất & Đăng nhập tài khoản khác</button>
        </form>
    </div>
</div>
