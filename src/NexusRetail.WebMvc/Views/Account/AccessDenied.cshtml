@{
    ViewData["Title"] = "Từ chối quyền truy cập (403 Forbidden)";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Khách vãng lai";
    var userName = User.Identity?.Name ?? "Chưa đăng nhập";
}

<div class="container py-5" style="max-width: 650px;">
    <div class="card border-0 shadow-lg rounded-4 p-5 text-center bg-white">
        <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px; font-size: 32px;">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3 class="fw-bolder text-dark mb-1">Truy cập bị từ chối (403 Forbidden)</h3>
        <p class="text-secondary small mb-3">Bạn không có đủ quyền hạn để thực hiện tác vụ này.</p>

        <!-- Role Diagnostic for Lecturer -->
        <div class="p-3 bg-light rounded-4 border text-start mb-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                <span class="small text-secondary">Tài khoản hiện tại:</span>
                <strong class="text-dark">@userName</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                <span class="small text-secondary">Vai trò đang giữ:</span>
                <span class="badge bg-primary">@userRole</span>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span class="small text-secondary">Yêu cầu quyền hạn:</span>
                <span class="badge bg-danger">Admin hoặc Staff</span>
            </div>
        </div>

        <div class="mb-4">
            <div class="small fw-bold text-secondary mb-2">Chuyển sang vai trò có thẩm quyền (Demo):</div>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a asp-action="QuickLogin" asp-route-role="admin" class="btn btn-sm btn-dark rounded-3 px-3 py-2 fw-bold shadow-sm">
                    Đăng nhập Admin
                </a>
                <a asp-action="QuickLogin" asp-route-role="staff" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-2 fw-bold">
                    Đăng nhập Nhân viên
                </a>
            </div>
        </div>

        <div class="pt-3 border-top d-flex justify-content-between align-items-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-link text-decoration-none small text-secondary p-0">
                ← Về trang chủ mua sắm
            </a>
            <a asp-action="Login" class="btn btn-link text-decoration-none small text-primary p-0 fw-bold">
                Trang đăng nhập chi tiết →
            </a>
        </div>
    </div>
</div>
