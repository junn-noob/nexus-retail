@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <span class="auth-logo">Duy<b>Mobile</b></span>
            <p class="auth-sub">Tạo tài khoản để theo dõi đơn hàng & nhận ưu đãi</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background:#fee2e2; border:1px solid #f87171; color:#b91c1c; padding:10px 14px; border-radius:8px; font-size:13.5px; margin-bottom:16px;">
                @Html.ValidationSummary(false, "")
            </div>
        }

        <form class="auth-form" method="post" asp-controller="Account" asp-action="Register" id="registerForm">
            @Html.AntiForgeryToken()

            <div class="form-field">
                <label for="regName">Họ và tên</label>
                <div class="input-wrap">
                    <span class="input-icon">👤</span>
                    <input id="regName" name="fullName" type="text" placeholder="Ví dụ: Nguyễn Văn A" autocomplete="name" required />
                </div>
            </div>

            <div class="form-field">
                <label for="regPhone">Số điện thoại</label>
                <div class="input-wrap">
                    <span class="input-icon">📱</span>
                    <input id="regPhone" name="phone" type="tel" placeholder="Ví dụ: 0912345678" autocomplete="tel" required />
                </div>
            </div>

            <div class="form-field">
                <label for="regPass">Mật khẩu</label>
                <div class="input-wrap">
                    <span class="input-icon">🔒</span>
                    <input id="regPass" name="password" type="password" placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" required minlength="6" />
                    <button type="button" class="toggle-pass" onclick="togglePass('regPass', this)" title="Hiện/ẩn mật khẩu">👁</button>
                </div>
            </div>

            <div class="form-field">
                <label for="regPassConfirm">Xác nhận mật khẩu</label>
                <div class="input-wrap">
                    <span class="input-icon">🔒</span>
                    <input id="regPassConfirm" name="confirmPassword" type="password" placeholder="Nhập lại mật khẩu..." autocomplete="new-password" required />
                    <button type="button" class="toggle-pass" onclick="togglePass('regPassConfirm', this)" title="Hiện/ẩn mật khẩu">👁</button>
                </div>
            </div>

            <div class="form-check">
                <label>
                    <input type="checkbox" required checked /> Tôi đồng ý với <a href="#">Điều khoản</a> và <a href="#">Chính sách bảo mật</a>
                </label>
            </div>

            <button type="submit" class="btn auth-btn">Tạo tài khoản →</button>

            <div class="auth-divider"><span>Đã có tài khoản?</span></div>

            <a asp-controller="Account" asp-action="Login" class="btn ghost auth-btn">
                Đăng nhập ngay
            </a>
        </form>

        <p class="auth-footer">
            Bằng cách tạo tài khoản, bạn đồng ý với
            <a href="#">Điều khoản sử dụng</a> và <a href="#">Chính sách bảo mật</a> của Duy Mobile.
        </p>
    </div>

    <div class="auth-visual">
        <div class="auth-visual-inner">
            <div class="auth-badge">🎁 Ưu đãi thành viên</div>
            <h2>Gia nhập cộng đồng Duy Mobile</h2>
            <p>Trải nghiệm dịch vụ chăm sóc khách hàng hàng đầu và hưởng trọn vẹn đặc quyền thành viên.</p>
            <ul class="auth-perks">
                <li><span>🎯</span> <span>Tích điểm giảm giá đến 5% cho đơn sau</span></li>
                <li><span>🎁</span> <span>Quà tặng sinh nhật độc quyền</span></li>
                <li><span>⚡</span> <span>Ưu tiên giao hàng hỏa tốc trong 2 giờ</span></li>
                <li><span>🔧</span> <span>Miễn phí vệ sinh & dán màn hình trọn đời</span></li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            if (input.type === "password") {
                input.type = "text";
                btn.textContent = "🙈";
            } else {
                input.type = "password";
                btn.textContent = "👁";
            }
        }
    </script>
}
