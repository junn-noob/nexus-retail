@model NexusRetail.Shared.DTOs.Auth.RegisterDto
@{
    ViewData["Title"] = "Đăng ký tài khoản thành viên";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="row g-0">
                    <!-- Brand Side -->
                    <div class="col-md-5 d-none d-md-flex flex-column justify-content-between p-5 text-white" 
                         style="background: linear-gradient(135deg, #0f172a, #1e1b4b 60%, #312e81);">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 text-white-50 small mb-4">
                                <i class="bi bi-gift-fill text-warning"></i> Gia nhập gia đình Duy Mobile
                            </div>
                            <h3 class="fw-bolder mb-3 lh-sm">Đăng ký thành viên nhận ngay ưu đãi độc quyền</h3>
                            <p class="text-white-50 small mb-4">Trở thành hội viên để tích điểm mua sắm, nhận mã giảm giá và bảo hành điện tử nhanh chóng không cần hóa đơn giấy.</p>
                            
                            <div class="d-flex flex-column gap-3">
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="rounded-circle bg-white bg-opacity-10 p-2 text-warning fs-5">
                                        <i class="bi bi-tag-fill"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-bold">Voucher chào mừng 100.000₫</div>
                                        <div class="text-white-50">Áp dụng ngay cho đơn hàng đầu tiên</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="rounded-circle bg-white bg-opacity-10 p-2 text-primary fs-5">
                                        <i class="bi bi-phone-flip"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-bold">Bảo hành điện tử 1-chạm</div>
                                        <div class="text-white-50">Tra cứu hạn bảo hành bằng SĐT</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="rounded-circle bg-white bg-opacity-10 p-2 text-success fs-5">
                                        <i class="bi bi-headset"></i>
                                    </div>
                                    <div class="small">
                                        <div class="fw-bold">Ưu tiên hỗ trợ kỹ thuật</div>
                                        <div class="text-white-50">Tư vấn viên AI & Chuyên gia hỗ trợ 24/7</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="small text-white-50 pt-4 border-top border-white border-opacity-10">
                            Hotline hỗ trợ miễn phí: <strong>1800.6868</strong>
                        </div>
                    </div>

                    <!-- Form Side -->
                    <div class="col-md-7 p-4 p-lg-5 bg-white">
                        <div class="mb-4">
                            <h3 class="fw-bold text-dark mb-1">Đăng ký tài khoản</h3>
                            <small class="text-secondary">Điền thông tin bên dưới để tạo tài khoản mới</small>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger rounded-3 small py-2">
                                <div asp-validation-summary="All"></div>
                            </div>
                        }

                        <form asp-action="Register" method="post" id="registerForm">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Username" class="form-label small fw-bold text-dark">Tên đăng nhập <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-person"></i></span>
                                    <input asp-for="Username" class="form-control border-start-0 py-2" placeholder="Ví dụ: nguyenvana" autocomplete="username" autofocus required />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-bold text-dark">Địa chỉ Email <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control border-start-0 py-2" placeholder="Ví dụ: a.nguyen@gmail.com" autocomplete="email" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label small fw-bold text-dark">Số điện thoại liên hệ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" type="tel" class="form-control border-start-0 py-2" placeholder="Ví dụ: 0912345678" autocomplete="tel" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label small fw-bold text-dark">Mật khẩu <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" id="regPassword" type="password" class="form-control border-start-0 border-end-0 py-2" placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" required />
                                    <button class="btn btn-outline-secondary border-start-0" type="button" id="toggleRegPwd" title="Ẩn/Hiện">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-dark">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-shield-check"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 py-2" placeholder="Nhập lại mật khẩu..." autocomplete="new-password" required />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold w-100 py-2 shadow-sm mb-4">
                                Hoàn tất đăng ký <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </form>

                        <div class="text-center small text-secondary">
                            Đã có tài khoản? <a asp-action="Login" class="fw-bold text-primary text-decoration-none">Đăng nhập ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('toggleRegPwd');
            const pwdInput = document.getElementById('regPassword');
            if (toggleBtn && pwdInput) {
                toggleBtn.addEventListener('click', () => {
                    if (pwdInput.type === 'password') {
                        pwdInput.type = 'text';
                        toggleBtn.innerHTML = '<i class="bi bi-eye-slash"></i>';
                    } else {
                        pwdInput.type = 'password';
                        toggleBtn.innerHTML = '<i class="bi bi-eye"></i>';
                    }
                });
            }
        });
    </script>
}
