@model NexusRetail.Shared.DTOs.Auth.RegisterDto
@{
    ViewData["Title"] = "Đăng ký tài khoản thành viên";
}

<div class="auth-wrapper">
    <div class="auth-container">
        <!-- Visual Brand Side -->
        <div class="auth-brand">
            <div class="brand-badge">✨ Gia nhập đại gia đình Duy Mobile</div>
            <h2>Đăng ký thành viên Nhận ngay ưu đãi độc quyền</h2>
            <p>Trở thành hội viên để tích điểm mua sắm, nhận mã giảm giá sinh nhật và bảo hành nhanh chóng không cần hóa đơn giấy.</p>
            
            <div class="auth-features">
                <div class="feature-item">
                    <span class="icon">🎁</span>
                    <div>
                        <strong>Voucher chào mừng 100.000₫</strong>
                        <span>Áp dụng ngay cho đơn hàng đầu tiên</span>
                    </div>
                </div>
                <div class="feature-item">
                    <span class="icon">📱</span>
                    <div>
                        <strong>Quản lý đơn hàng & Bảo hành</strong>
                        <span>Tra cứu mọi lịch sử thiết bị chỉ bằng 1 chạm</span>
                    </div>
                </div>
                <div class="feature-item">
                    <span class="icon">⚡</span>
                    <div>
                        <strong>Ưu tiên tư vấn AI & Kỹ thuật</strong>
                        <span>Hỗ trợ kỹ thuật 24/7 từ chuyên gia</span>
                    </div>
                </div>
            </div>

            <div class="brand-footer">
                <span>Hotline hỗ trợ miễn cước: <strong>1800.6868</strong></span>
            </div>
        </div>

        <!-- Form Side -->
        <div class="auth-form-card">
            <div class="form-header">
                <h3>Đăng ký tài khoản</h3>
                <p>Điền thông tin bên dưới để tạo tài khoản mới</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Username">Tên đăng nhập <span style="color: #ef4444;">*</span></label>
                    <div class="input-wrap">
                        <span class="input-icon">👤</span>
                        <input asp-for="Username" placeholder="Ví dụ: nguyenvana" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Địa chỉ Email <span style="color: #ef4444;">*</span></label>
                    <div class="input-wrap">
                        <span class="input-icon">✉️</span>
                        <input asp-for="Email" type="email" placeholder="Ví dụ: a.nguyen@gmail.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber">Số điện thoại liên hệ</label>
                    <div class="input-wrap">
                        <span class="input-icon">📞</span>
                        <input asp-for="PhoneNumber" type="tel" placeholder="Ví dụ: 0912345678" autocomplete="tel" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Mật khẩu <span style="color: #ef4444;">*</span></label>
                    <div class="input-wrap">
                        <span class="input-icon">🔒</span>
                        <input asp-for="Password" id="regPassword" type="password" placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" />
                        <button type="button" class="pwd-toggle" id="toggleRegPwd" title="Ẩn/Hiện">👁️</button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu <span style="color: #ef4444;">*</span></label>
                    <div class="input-wrap">
                        <span class="input-icon">🔒</span>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu..." autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-auth">Hoàn tất đăng ký →</button>
            </form>

            <div class="form-switch">
                Đã có tài khoản? <a asp-action="Login">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-wrapper {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        background: radial-gradient(circle at 10% 20%, rgba(91, 75, 219, 0.08) 0%, transparent 40%),
                    radial-gradient(circle at 90% 80%, rgba(124, 108, 240, 0.08) 0%, transparent 40%),
                    var(--bg);
    }
    .auth-container {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        max-width: 980px;
        width: 100%;
        background: var(--card);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(23, 23, 43, 0.1);
        border: 1px solid var(--line);
    }
    .auth-brand {
        background: linear-gradient(135deg, #181534, #272052 60%, #3e327a);
        color: #fff;
        padding: 48px 40px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .brand-badge {
        display: inline-block;
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        padding: 6px 14px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .5px;
        color: #d1c9ff;
        border: 1px solid rgba(255, 255, 255, 0.15);
        margin-bottom: 24px;
    }
    .auth-brand h2 {
        font-size: 28px;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 14px;
        background: linear-gradient(to right, #fff, #c8c2fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .auth-brand p {
        color: #b5b0db;
        font-size: 14.5px;
        line-height: 1.6;
        margin-bottom: 32px;
    }
    .auth-features {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-bottom: 32px;
    }
    .feature-item {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .feature-item .icon {
        font-size: 24px;
        background: rgba(255, 255, 255, 0.08);
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .feature-item strong {
        display: block;
        font-size: 14.5px;
        color: #f1effe;
    }
    .feature-item span {
        font-size: 12.5px;
        color: #9f9ac6;
    }
    .brand-footer {
        font-size: 12px;
        color: #79749f;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 20px;
    }
    .auth-form-card {
        padding: 36px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .form-header {
        margin-bottom: 20px;
    }
    .form-header h3 {
        font-size: 24px;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }
    .form-header p {
        font-size: 14px;
        color: var(--mute);
    }
    .form-group {
        margin-bottom: 14px;
    }
    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 6px;
    }
    .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }
    .input-icon {
        position: absolute;
        left: 14px;
        font-size: 16px;
        pointer-events: none;
        opacity: 0.7;
    }
    .input-wrap input {
        width: 100%;
        padding: 11px 14px 11px 42px;
        border: 1.5px solid var(--line);
        border-radius: 12px;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease;
        background: #fafafc;
    }
    .input-wrap input:focus {
        border-color: var(--ac);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(91, 75, 219, 0.12);
    }
    .pwd-toggle {
        position: absolute;
        right: 12px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        font-size: 16px;
        opacity: 0.6;
    }
    .field-validation-error {
        color: #ef4444;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }
    .btn-auth {
        width: 100%;
        margin-top: 10px;
        padding: 13px;
        font-size: 15px;
        font-weight: 700;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--ac), var(--ac2));
        color: #fff;
        border: none;
        box-shadow: 0 6px 18px rgba(91, 75, 219, 0.35);
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-auth:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(91, 75, 219, 0.45);
    }
    .form-switch {
        margin-top: 20px;
        text-align: center;
        font-size: 13.5px;
        color: var(--mute);
    }
    .form-switch a {
        color: var(--ac);
        font-weight: 700;
        text-decoration: none;
    }
    .form-switch a:hover {
        text-decoration: underline;
    }
    .alert {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13.5px;
        margin-bottom: 16px;
    }
    .alert-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }
    .alert-danger ul {
        margin: 0;
        padding-left: 18px;
    }

    @@media (max-width: 820px) {
        .auth-container {
            grid-template-columns: 1fr;
            max-width: 480px;
        }
        .auth-brand {
            padding: 32px 24px;
        }
        .auth-form-card {
            padding: 32px 24px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('toggleRegPwd');
        const pwdInput = document.getElementById('regPassword');
        if (toggleBtn && pwdInput) {
            toggleBtn.addEventListener('click', () => {
                if (pwdInput.type === 'password') {
                    pwdInput.type = 'text';
                    toggleBtn.textContent = '🙈';
                } else {
                    pwdInput.type = 'password';
                    toggleBtn.textContent = '👁️';
                }
            });
        }
    });
</script>
