<!-- FLOATING CHAT BUTTON (FAB) -->
<button type="button" id="fab" class="chat-fab" aria-label="Mở trợ lý ảo AI" title="Hỏi trợ lý ảo Duy Mobile">
    <span class="chat-icon">✨</span>
</button>

<!-- CHAT WINDOW CONTAINER -->
<div id="chat" class="chat-panel" role="dialog" aria-label="Trợ lý ảo AI tư vấn">
    <div class="chat-header">
        <div class="chat-title">
            <span class="chat-badge">AI</span>
            <div>
                <h4>Trợ lý AI Duy Mobile</h4>
                <p>Tư vấn chọn máy & tra cứu bảo hành</p>
            </div>
        </div>
        <button type="button" class="chat-close" onclick="closeChatModal()" title="Đóng chat">✕</button>
    </div>

    <!-- MESSAGES LIST -->
    <div id="cm" class="chat-messages">
        <div class="msg bot">
            <p>Xin chào! Mình là trợ lý ảo của <strong>Duy Mobile</strong>. Bạn cần tư vấn mẫu máy nào (chụp ảnh, chơi game, tầm giá) hoặc cần <strong>tra cứu đơn hàng / bảo hành bằng SĐT</strong> thì nhắn cho mình nhé! ✨</p>
        </div>
    </div>

    <!-- CHAT INPUT FORM -->
    <div class="chat-form">
        <input type="text" id="ci" placeholder="Nhập nhu cầu hoặc SĐT..." autocomplete="off" />
        <button type="button" id="cs" class="btn" title="Gửi tin nhắn">Gửi</button>
    </div>
</div>

<style>
    .chat-fab {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--ac), var(--ac2));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(91, 75, 219, .4);
        cursor: pointer;
        z-index: 1000;
        transition: transform .25s ease, box-shadow .25s ease;
        border: 2px solid rgba(255, 255, 255, .2);
    }
    .chat-fab:hover {
        transform: scale(1.08);
        box-shadow: 0 10px 28px rgba(91, 75, 219, .5);
    }
    .chat-icon {
        font-size: 26px;
    }
    .chat-panel {
        position: fixed;
        bottom: 96px;
        right: 24px;
        width: 380px;
        max-width: calc(100vw - 32px);
        height: 520px;
        max-height: calc(100vh - 120px);
        background: var(--card);
        border-radius: 20px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, .2);
        display: flex;
        flex-direction: column;
        z-index: 1000;
        overflow: hidden;
        border: 1px solid var(--line);
        opacity: 0;
        transform: translateY(20px) scale(.95);
        pointer-events: none;
        transition: all .25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .chat-panel.open {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }
    .chat-header {
        background: linear-gradient(135deg, #17172b, #28244d);
        color: #fff;
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .chat-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chat-badge {
        background: var(--ac);
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        padding: 3px 7px;
        border-radius: 6px;
    }
    .chat-header h4 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
    }
    .chat-header p {
        margin: 2px 0 0;
        font-size: 11px;
        color: #a5a5c0;
    }
    .chat-close {
        color: #fff;
        font-size: 18px;
        opacity: .7;
        padding: 4px;
        cursor: pointer;
    }
    .chat-close:hover {
        opacity: 1;
    }
    .chat-messages {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: var(--bg);
    }
    .msg {
        max-width: 85%;
        padding: 10px 14px;
        border-radius: 14px;
        font-size: 13.5px;
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-word;
    }
    .msg.bot {
        align-self: flex-start;
        background: var(--card);
        color: var(--ink);
        border: 1px solid var(--line);
        border-bottom-left-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }
    .msg.me {
        align-self: flex-end;
        background: var(--ac);
        color: #fff;
        border-bottom-right-radius: 4px;
    }
    .msg button {
        display: block;
        width: 100%;
        margin-top: 6px;
        padding: 6px 10px;
        background: var(--soft);
        color: var(--ac);
        font-size: 12px;
        font-weight: 600;
        border-radius: 8px;
        text-align: left;
        cursor: pointer;
        transition: background .2s;
    }
    .msg button:hover {
        background: #e2ddfe;
    }
    .chat-form {
        display: flex;
        padding: 12px;
        background: var(--card);
        border-top: 1px solid var(--line);
        gap: 8px;
    }
    .chat-form input {
        flex: 1;
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid var(--line);
        font-size: 14px;
        outline: none;
    }
    .chat-form input:focus {
        border-color: var(--ac);
    }
    .chat-form button {
        padding: 10px 18px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
    }
</style>

<script>
    function closeChatModal() {
        const c = document.getElementById('chat');
        if (c) c.classList.remove('open');
    }
    document.addEventListener('DOMContentLoaded', () => {
        const heroBtn = document.getElementById('heroAI');
        if (heroBtn) {
            heroBtn.addEventListener('click', () => {
                const c = document.getElementById('chat');
                if (c) {
                    c.classList.add('open');
                    const input = document.getElementById('ci');
                    if (input) input.focus();
                }
            });
        }
    });
</script>
