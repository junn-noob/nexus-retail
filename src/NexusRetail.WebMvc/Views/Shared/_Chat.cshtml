<!-- FLOATING CHAT FAB -->
<button type="button" id="fab" class="dm-chat-fab" aria-label="Mở trợ lý ảo AI" title="Hỏi trợ lý ảo Duy Mobile (Gemini AI)">
    <i class="bi bi-robot fs-3"></i>
    <span class="dm-chat-ping"></span>
</button>

<!-- FLOATING CHAT WINDOW CONTAINER -->
<div id="chat" class="dm-chat-panel" role="dialog" aria-label="Trợ lý ảo AI tư vấn">
    <!-- Header -->
    <div class="dm-chat-header">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary px-2 py-1 fw-bold"><i class="bi bi-stars"></i> GEMINI 1.5</span>
            <div>
                <h6 class="m-0 fw-bold text-white">Trợ lý AI Duy Mobile</h6>
                <small class="text-white-50"><span class="badge bg-success p-1 rounded-circle d-inline-block me-1"></span> Đang trực tuyến</small>
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-link text-white-50 text-decoration-none p-0 fs-5" onclick="closeChat()" title="Đóng chat">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Messages Container -->
    <div id="cm" class="dm-chat-messages">
        <div class="dm-msg dm-msg-bot">
            <p class="m-0 mb-2">Xin chào! Mình là trợ lý AI thông minh của <strong>Duy Mobile</strong>. Mình có thể giúp bạn chọn mẫu máy phù hợp theo ngân sách, so sánh cấu hình hoặc <strong>tra cứu đơn hàng / bảo hành bằng Số điện thoại</strong>!</p>
            <div class="d-flex flex-wrap gap-1 mt-2">
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2 small" onclick="sendChatPrompt('Tư vấn máy chụp ảnh đẹp dưới 20 triệu')">
                    📸 Chụp ảnh đẹp &lt; 20tr
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2 small" onclick="sendChatPrompt('Điện thoại nào chơi game mượt pin trâu nhất?')">
                    🎮 Gaming pin trâu
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2 small" onclick="sendChatPrompt('So sánh iPhone 16 Plus và Samsung S24 Ultra')">
                    ⚖️ So sánh Flagship
                </button>
            </div>
        </div>
    </div>

    <!-- Chat Form Input -->
    <div class="p-3 bg-white border-top">
        <div class="input-group">
            <input type="text" id="ci" class="form-control rounded-start-3" placeholder="Nhập câu hỏi hoặc SĐT tra cứu..." autocomplete="off" />
            <button type="button" id="cs" class="btn btn-primary rounded-end-3 px-3 fw-bold">
                <i class="bi bi-send-fill me-1"></i> Gửi
            </button>
        </div>
    </div>
</div>
