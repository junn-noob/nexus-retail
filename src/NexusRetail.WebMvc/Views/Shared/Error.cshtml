@model ErrorViewModel
@{
    var code = Model.StatusCode;
    ViewData["Title"] = code switch
    {
        404 => "Không tìm thấy trang (404)",
        403 => "Không có quyền truy cập (403)",
        _ => "Đã xảy ra sự cố"
    };
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5 bg-white">
                <div class="mb-3">
                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 fw-bold fs-6">
                        Mã trạng thái: @code
                    </span>
                </div>

                @if (code == 404)
                {
                    <h1 class="h3 fw-bolder text-dark mb-2">Không tìm thấy trang bạn yêu cầu</h1>
                    <p class="text-secondary mb-4">
                        Đường dẫn có thể đã thay đổi, sản phẩm ngừng kinh doanh hoặc địa chỉ nhập chưa chính xác.
                    </p>
                }
                else if (code == 403)
                {
                    <h1 class="h3 fw-bolder text-dark mb-2">Bạn không có quyền truy cập mục này</h1>
                    <p class="text-secondary mb-4">
                        Vui lòng đăng nhập bằng tài khoản có quyền phù hợp hoặc quay lại trang cửa hàng.
                    </p>
                }
                else
                {
                    <h1 class="h3 fw-bolder text-dark mb-2">Hệ thống đang gặp gián đoạn tạm thời</h1>
                    <p class="text-secondary mb-4">
                        Yêu cầu chưa thể xử lý ngay lúc này. Vui lòng thử lại sau ít phút hoặc liên hệ tổng đài hỗ trợ <strong>1800.6868</strong>.
                    </p>
                }

                @if (Model.ShowRequestId)
                {
                    <div class="small text-muted mb-4">
                        Mã tra cứu kỹ thuật: <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-bold rounded-3 px-4">
                        <i class="bi bi-house-door me-1"></i> Về trang chủ
                    </a>
                    <a asp-controller="Home" asp-action="TraCuu" class="btn btn-outline-secondary fw-semibold rounded-3 px-4">
                        <i class="bi bi-receipt me-1"></i> Tra cứu đơn hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
