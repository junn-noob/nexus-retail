@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] — TechStore</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <header>
        <div class="nav">
            <a class="logo" asp-controller="Home" asp-action="Index">Tech<b>Store</b></a>
            <nav class="menu">
                @await Component.InvokeAsync("NhanHieu")
            </nav>
            <form class="search" method="get" asp-controller="Home" asp-action="Index" asp-fragment="products">
                <input name="q" type="search" placeholder="Tìm sản phẩm…" aria-label="Tìm sản phẩm" value="@Context.Request.Query["q"]">
            </form>
            <div class="user">
                @if (signedIn)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn ghost" asp-controller="Admin" asp-action="Index">Quản trị</a>
                    }
                    <span>@User.Identity!.Name</span>
                    <form method="post" asp-controller="Account" asp-action="Logout"><button class="btn ghost">Đăng xuất</button></form>
                }
                else
                {
                    <a class="btn ghost" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a class="btn" asp-controller="Account" asp-action="Register">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <section class="hero">
      <div>
        <h1>Công nghệ phù hợp với nhu cầu của bạn.</h1>
        <p>Khám phá sản phẩm, xem cấu hình nhanh và hỏi AI để tìm thiết bị phù hợp.</p>
      </div>
      <div class="aibox">
        <h3>✨ AI tư vấn TechStore</h3>
        <p>Nói nhu cầu và ngân sách, AI sẽ gợi ý vài thiết bị đáng cân nhắc.</p>
        <button class="btn" id="heroAI">Hỏi AI ngay</button>
      </div>
    </section>

    @RenderBody()

    <div class="ov" id="ov" role="dialog" aria-modal="true"><div class="modal" id="modal"></div></div>
    @* <partial name="_Chat" /> *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
