@using NexusRetail.Shared.Entities
@model List<NhanHieu>

<div class="dm-brand-nav">
    <span class="text-secondary small fw-bold me-2 d-none d-md-inline"><i class="bi bi-tag-fill text-primary me-1"></i> Thương hiệu:</span>

    <a class="dm-brand-pill active" href="/#productCatalog" data-id="">
        Tất cả
    </a>

    @if (Model != null)
    {
        @foreach (var i in Model)
        {
            <a class="dm-brand-pill" href="/?brand=@Uri.EscapeDataString(i.MaNhanHieu)#productCatalog" data-id="@i.MaNhanHieu">
                @i.TenNhanHieu
            </a>
        }
    }
</div>
