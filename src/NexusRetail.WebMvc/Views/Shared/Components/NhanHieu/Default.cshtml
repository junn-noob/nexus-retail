@using NexusRetail.Shared.Entities
@model List<NhanHieu>

<div class="dm-brand-nav">
    <span class="text-secondary small fw-bold me-2 d-none d-md-inline"><i class="bi bi-tag-fill text-primary me-1"></i> Thương hiệu:</span>
    
    <a class="dm-brand-pill active" data-id="" onclick="locTheoNhanHieu('', this, 1)">
        Tất cả
    </a>

    @if (Model != null)
    {
        @foreach (var i in Model)
        {
            <a class="dm-brand-pill" data-id="@i.MaNhanHieu" onclick="locTheoNhanHieu('@i.MaNhanHieu', this, 1)">
                @i.TenNhanHieu
            </a>
        }
    }
</div>

<script>
    let activeBrandId = '';

    function locTheoNhanHieu(maNhanHieu, element, page = 1) {
        const grid = document.getElementById('productGrid');
        if (!grid) {
            // Đang ở trang khác (Cart, Admin, Login), chuyển về trang chủ lọc theo Brand
            window.location.href = maNhanHieu ? ('/?brand=' + encodeURIComponent(maNhanHieu) + '#productCatalog') : '/#productCatalog';
            return;
        }

        // Đổi trạng thái active trên các nút thương hiệu
        document.querySelectorAll('.dm-brand-pill').forEach(el => el.classList.remove('active'));
        if (element) {
            element.classList.add('active');
        } else {
            const target = document.querySelector(`.dm-brand-pill[data-id="${maNhanHieu}"]`);
            if (target) target.classList.add('active');
        }
        activeBrandId = maNhanHieu;

        // Hiển thị trạng thái đang tải
        grid.innerHTML = `
            <div class="col-12 py-5 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <div class="mt-3 text-secondary fw-semibold">Đang nạp danh sách sản phẩm...</div>
            </div>
        `;

        const url = `/Home/LaySanPhamTheoNhanHieu?maNhanHieu=${encodeURIComponent(maNhanHieu || '')}&page=${page}`;

        $.ajax({
            url: url,
            type: 'GET',
            success: function (data) {
                renderDanhSachSanPham(data.items);
                renderPhanTrangBrand(data);
                
                const headerCount = document.getElementById('productCountHeader');
                if (headerCount) {
                    headerCount.textContent = `Danh sách sản phẩm (${data.totalItems || 0})`;
                }

                const pageInd = document.getElementById('pageIndicator');
                if (pageInd) {
                    pageInd.textContent = `Trang ${data.page || 1} / ${Math.max(1, data.totalPages || 1)}`;
                }

                const catalog = document.getElementById('productCatalog');
                if (catalog) {
                    catalog.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            },
            error: function (xhr) {
                console.error("Lỗi khi tải sản phẩm:", xhr);
                grid.innerHTML = `
                    <div class="col-12 py-5 text-center text-danger">
                        <i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i>
                        <h5>Không thể kết nối đến máy chủ.</h5>
                        <p class="small text-secondary">Vui lòng thử lại sau giây lát.</p>
                    </div>
                `;
            }
        });
    }

    function renderDanhSachSanPham(items) {
        const grid = document.getElementById('productGrid');
        if (!grid) return;

        if (!items || items.length === 0) {
            grid.innerHTML = `
                <div class="col-12 py-5 text-center">
                    <div class="p-5 bg-white rounded-4 border shadow-sm">
                        <i class="bi bi-phone text-secondary fs-1 d-block mb-3"></i>
                        <h4 class="fw-bold text-dark">Chưa có sản phẩm nào thuộc nhãn hiệu này!</h4>
                        <p class="text-secondary small mb-3">Hệ thống đang nhập thêm hàng mới cho thương hiệu bạn chọn.</p>
                        <button type="button" class="btn btn-primary rounded-3 fw-bold px-4" onclick="locTheoNhanHieu('', document.querySelector('.dm-brand-pill[data-id=\\'\\']'), 1)">
                            Xem tất cả sản phẩm
                        </button>
                    </div>
                </div>
            `;
            return;
        }

        let html = '';
        items.forEach(sp => {
            const imgSrc = sp.anh ? `/images/products/${sp.anh}` : '/images/products/iphone_16_plus_black_37a9bceca0.png';
            const isFlagship = sp.giaBan > 25000000;
            const badgeHtml = isFlagship
                ? '<span class="dm-badge dm-badge-flagship">Flagship</span>'
                : '<span class="dm-badge dm-badge-hot">Bán chạy</span>';
            const brandName = sp.tenNhanHieu || 'Chính hãng';
            const noteText = sp.ghiChu || 'Bảo hành 12 tháng VNA';
            const formattedPrice = Number(sp.giaBan).toLocaleString('vi-VN') + ' ₫';

            html += `
                <div class="col-lg-4 col-md-6">
                    <div class="dm-product-card">
                        <div class="dm-product-badge-wrap">
                            ${badgeHtml}
                        </div>
                        <div class="dm-product-img-box" onclick="openProduct('${sp.maSp}')">
                            <img src="${imgSrc}" alt="${sp.tenSp}" onerror="this.src='/images/products/iphone_16_plus_black_37a9bceca0.png';" />
                        </div>
                        <div class="dm-product-body">
                            <div class="dm-product-brand">${brandName}</div>
                            <h3 class="dm-product-title" onclick="openProduct('${sp.maSp}')" title="${sp.tenSp}">${sp.tenSp}</h3>
                            <span class="dm-product-tag">${noteText}</span>
                            <div class="dm-product-price">${formattedPrice}</div>
                            <div class="dm-card-actions">
                                <button type="button" class="dm-btn-quickview" onclick="openProduct('${sp.maSp}')">
                                    Chi tiết
                                </button>
                                <button type="button" class="dm-btn-addcart" onclick="quickAddToCart(event, '${sp.maSp}')" title="Thêm vào giỏ">
                                    <i class="bi bi-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });

        grid.innerHTML = html;
    }

    function renderPhanTrangBrand(data) {
        const area = document.getElementById('paginationArea');
        if (!area) return;

        if (!data || data.totalPages <= 1) {
            area.innerHTML = '';
            return;
        }

        let html = '<ul class="pagination pagination-md justify-content-center m-0 gap-1">';
        // Prev
        if (data.page > 1) {
            html += `<li class="page-item"><a class="page-link rounded-3 fw-bold" href="javascript:void(0)" onclick="locTheoNhanHieu('${activeBrandId}', null, ${data.page - 1})">← Trước</a></li>`;
        } else {
            html += `<li class="page-item disabled"><span class="page-link rounded-3 opacity-50">← Trước</span></li>`;
        }

        // Pages
        for (let i = 1; i <= data.totalPages; i++) {
            if (i === data.page) {
                html += `<li class="page-item active"><span class="page-link rounded-3 fw-bold">${i}</span></li>`;
            } else {
                html += `<li class="page-item"><a class="page-link rounded-3 fw-bold" href="javascript:void(0)" onclick="locTheoNhanHieu('${activeBrandId}', null, ${i})">${i}</a></li>`;
            }
        }

        // Next
        if (data.page < data.totalPages) {
            html += `<li class="page-item"><a class="page-link rounded-3 fw-bold" href="javascript:void(0)" onclick="locTheoNhanHieu('${activeBrandId}', null, ${data.page + 1})">Sau →</a></li>`;
        } else {
            html += `<li class="page-item disabled"><span class="page-link rounded-3 opacity-50">Sau →</span></li>`;
        }
        html += '</ul>';

        area.innerHTML = html;
    }

    // Auto-detect brand query param on load
    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const b = params.get('brand');
        if (b) {
            activeBrandId = b;
            const target = document.querySelector(`.dm-brand-pill[data-id="${b}"]`);
            if (target) {
                document.querySelectorAll('.dm-brand-pill').forEach(el => el.classList.remove('active'));
                target.classList.add('active');
            }
        }
    });
</script>