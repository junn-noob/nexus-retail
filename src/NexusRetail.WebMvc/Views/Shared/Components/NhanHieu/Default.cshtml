@using NexusRetail.Shared.Entities
@model List<NhanHieu>

@foreach (var i in Model)
{
    <a style="cursor: pointer"
       class="brand-item"
       data-id="@i.MaNhanHieu"
       onclick="laySanPhamTheoNhanHieu('@i.MaNhanHieu', this, 1)">
        @i.TenNhanHieu
    </a>
}

<script>
    let currentBrand = null;

    function laySanPhamTheoNhanHieu(maNhanHieu, element, page = 1) {
        // Chỉ đổi brand khi click brand
        if (element) {
            $('.brand-item').removeClass('on');
            $(element).addClass('on');

            currentBrand = maNhanHieu;
        }
        $.ajax({
            url: '/Home/LaySanPhamTheoNhanHieu',
            type: 'GET',

            data: {
                maNhanHieu: maNhanHieu,
                page: page
            },

            success: function (data) {

                renderProducts(data.items);
                renderPagination(data);
            },

            error: function (xhr) {
                console.log(xhr);
            }
        });
    }


    function renderProducts(items) {
        let html = '';
        if (!items || items.length === 0) {
            html = '<div class="empty" style="grid-column:1/-1; text-align:center; padding: 40px; background:var(--card); border-radius:16px;">Không có sản phẩm nào thuộc nhãn hiệu này.</div>';
            $('#products').html(html);
            return;
        }
        items.forEach(sp => {
            const imgSrc = sp.anh ? `/images/products/${sp.anh}` : '/images/products/default.jpg';
            html += `<article class="card" data-id="${sp.maSp}">
                        <div class="img" style="background-image: url('${imgSrc}')"></div>
                        <div class="cb">
                        <h3>${sp.tenSp}</h3>
                        <span class="tag">${sp.ghiChu ?? ''}</span>
                        <div class="price">${sp.giaBan.toLocaleString('vi-VN')} đ</div>
                        <div style="display: flex; gap: 8px; margin-top: 10px;">
                            <button class="btn ghost" type="button" style="flex: 1;">Xem nhanh</button>
                            <button class="btn" type="button" onclick="quickAddToCart(event, '${sp.maSp}')" title="Thêm vào giỏ" style="padding: 0 14px; background: var(--soft); color: var(--ac); font-weight: 700; border-radius: 10px;">🛒</button>
                        </div>
                        </div>
                    </article>`;
        });
        $('#products').html(html);
    }


    function renderPagination(data) {
        let html = '';
        if (data.totalPages <= 1) {
            $('#pagination').html('');
            return;
        }
        // Previous
        if (data.page > 1) {
            html += `
                <a onclick="laySanPhamTheoNhanHieu(
                    '${currentBrand}',
                    null,
                    ${data.page - 1}
                )">
                    ←
                </a>
            `;
        }
        else {
            html += `<a class="off">←</a>`;
        }

        // Page numbers
        for (let i = 1; i <= data.totalPages; i++) {

            html += `
                <a class="${i === data.page ? 'on' : ''}"
                   onclick="laySanPhamTheoNhanHieu(
                        '${currentBrand}',
                        null,
                        ${i}
                   )">
                    ${i}
                </a>
            `;
        }

        // Next
        if (data.page < data.totalPages) {
            html += `
                <a onclick="laySanPhamTheoNhanHieu(
                    '${currentBrand}',
                    null,
                    ${data.page + 1}
                )">
                    →
                </a>
            `;
        }
        else {
            html += `<a class="off">→</a>`;
        }

        $('#pagination').html(html);
    }
</script>