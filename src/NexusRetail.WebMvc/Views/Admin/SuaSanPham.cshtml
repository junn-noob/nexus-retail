@model NexusRetail.WebMvc.Models.AdminProductViewModel

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm " + Model.MaSp;
    var loais = ViewBag.Loais as List<NexusRetail.WebMvc.Models.CategoryOption> ?? new();
    var nhanHieus = ViewBag.NhanHieus as List<NexusRetail.WebMvc.Models.BrandOption> ?? new();
    var manHinhs = ViewBag.ManHinhs as List<NexusRetail.WebMvc.Models.ScreenOption> ?? new();
    var imgUrl = string.IsNullOrWhiteSpace(Model.Anh) ? "/images/products/iphone_16_plus_black_37a9bceca0.png" : $"/images/products/{Model.Anh}";
}

<partial name="_AdminNav" />

<div class="container pb-5" style="max-width: 860px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-pencil-square text-primary me-2"></i> Chỉnh sửa sản phẩm: @Model.MaSp</h3>
            <small class="text-secondary">Cập nhật thông số kỹ thuật, giá vốn và giá niêm yết hàng hóa</small>
        </div>
        <a asp-action="SanPham" class="btn btn-outline-secondary rounded-3 fw-bold btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0 mb-4">
            @Html.ValidationSummary(false, "")
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <form method="post" asp-action="SuaSanPham" asp-route-id="@Model.MaSp" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaSp" />
            <input type="hidden" asp-for="Anh" />

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="TenSp" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="TenSp" class="form-control rounded-3 py-2" required />
                    <span asp-validation-for="TenSp" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLoai" class="form-label small fw-bold text-dark"></label>
                    <select asp-for="MaLoai" class="form-select rounded-3 py-2" required>
                        <option value="">-- Chọn loại sản phẩm --</option>
                        @foreach (var l in loais)
                        {
                            <option value="@l.MaLoai">@l.TenLoai</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaNhanHieu" class="form-label small fw-bold text-dark"></label>
                    <select asp-for="MaNhanHieu" class="form-select rounded-3 py-2" required>
                        <option value="">-- Chọn nhãn hiệu --</option>
                        @foreach (var nh in nhanHieus)
                        {
                            <option value="@nh.MaNhanHieu">@nh.TenNhanHieu</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaManHinh" class="form-label small fw-bold text-dark"></label>
                    <select asp-for="MaManHinh" class="form-select rounded-3 py-2">
                        <option value="">-- Chọn màn hình --</option>
                        @foreach (var mh in manHinhs)
                        {
                            <option value="@mh.MaManHinh">@mh.TenManHinh</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="ThoiGianBaoHanh" class="form-label small fw-bold text-dark"></label>
                    <div class="input-group">
                        <input asp-for="ThoiGianBaoHanh" type="number" class="form-control rounded-start-3 py-2" />
                        <span class="input-group-text rounded-end-3">tháng</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="GiaNhap" class="form-label small fw-bold text-dark"></label>
                    <div class="input-group">
                        <input asp-for="GiaNhap" type="number" step="1000" id="txtGiaNhap" class="form-control rounded-start-3 py-2" oninput="calculateGiaBan(this.value)" required />
                        <span class="input-group-text rounded-end-3">₫</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Giá bán niêm yết (Dự kiến):</label>
                    <div class="form-control bg-light py-2 fw-bolder text-danger fs-5 rounded-3 d-flex align-items-center" id="txtGiaBanPreview">
                        @Model.GiaBan.ToString("N0") ₫
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoLuong" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="SoLuong" type="number" class="form-control rounded-3 py-2" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="FileAnh" class="form-label small fw-bold text-dark">Thay đổi hình ảnh mới (.jpg, .png)</label>
                    <input asp-for="FileAnh" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control rounded-3 mb-2" />
                    <div class="d-flex align-items-center gap-2">
                        <small class="text-secondary">Ảnh hiện tại:</small>
                        <img src="@imgUrl" alt="@Model.TenSp" class="rounded-3 border p-1 bg-light" style="width: 40px; height: 40px; object-fit: contain;" />
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="ChupAnh" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="ChupAnh" class="form-control rounded-3 py-2" />
                </div>

                <div class="col-md-6">
                    <label asp-for="AmThanh" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="AmThanh" class="form-control rounded-3 py-2" />
                </div>

                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label small fw-bold text-dark"></label>
                    <textarea asp-for="GhiChu" rows="3" class="form-control rounded-3"></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="SanPham" class="btn btn-outline-secondary rounded-3 px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function calculateGiaBan(giaNhap) {
            const val = parseFloat(giaNhap) || 0;
            const giaBan = Math.round(val * 1.1);
            const el = document.getElementById("txtGiaBanPreview");
            if (el) el.textContent = giaBan.toLocaleString('vi-VN') + " ₫";
        }
        document.addEventListener('DOMContentLoaded', () => {
            const inp = document.getElementById("txtGiaNhap");
            if (inp) calculateGiaBan(inp.value);
        });
    </script>
}
