@model List<NexusRetail.WebMvc.Models.AdminInboundInvoiceItem>

@{
    ViewData["Title"] = "Quản lý nhập kho (Admin)";
}

<partial name="_AdminNav" />

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-truck text-primary me-2"></i> Lịch sử phiếu nhập kho</h3>
            <small class="text-secondary">Tổng cộng: <strong>@(Model?.Count ?? 0)</strong> phiếu nhập hàng từ nhà cung cấp</small>
        </div>
        <a asp-action="TaoHoaDonNhap" class="btn btn-primary rounded-3 fw-bold px-4 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Lập phiếu nhập mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th class="ps-4">Mã HDN</th>
                        <th>Ngày nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Nhân viên phụ trách</th>
                        <th class="text-center">Số mặt hàng</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.MaHdn</td>
                                <td class="text-secondary small">@item.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-semibold text-primary">@item.TenNcc</td>
                                <td class="text-secondary">@item.TenNv</td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">
                                        @item.SoMatHang SP
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-danger">@item.TongTien.ToString("N0") ₫</td>
                                <td class="text-center pe-4">
                                    <a asp-action="ChiTietHoaDonNhap" asp-route-id="@item.MaHdn" class="btn btn-sm btn-outline-primary rounded-3 px-3">
                                        <i class="bi bi-eye me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có phiếu nhập kho nào trên hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

