@model NexusRetail.WebMvc.Models.AdminProductViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm mới (Admin)";
    var loais = ViewBag.Loais as List<NexusRetail.WebMvc.Models.CategoryOption> ?? new();
    var nhanHieus = ViewBag.NhanHieus as List<NexusRetail.WebMvc.Models.BrandOption> ?? new();
    var manHinhs = ViewBag.ManHinhs as List<NexusRetail.WebMvc.Models.ScreenOption> ?? new();
}

<partial name="_AdminNav" />

<div class="container pb-5" style="max-width: 860px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-plus-circle text-primary me-2"></i> Thêm sản phẩm mới</h3>
            <small class="text-secondary">Tự động thực thi quy tắc <strong>BR-03: Giá bán = Giá nhập × 1.10</strong></small>
        </div>
        <a asp-action="SanPham" class="btn btn-outline-secondary rounded-3 fw-bold btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0 mb-4">
            @Html.ValidationSummary(false, "")
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <form method="post" asp-action="ThemSanPham" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="TenSp" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="TenSp" class="form-control rounded-3 py-2" placeholder="Ví dụ: iPhone 16 Pro Max 256GB VNA" required />
                    <span asp-validation-for="TenSp" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLoai" class="form-label small fw-bold text-dark"></label>
                    <select asp-for="MaLoai" class="form-select rounded-3 py-2" required>
                        <option value="">-- Chọn loại sản phẩm --</option>
                        @foreach (var l in loais)
                        {
                            <option value="@l.MaLoai">@l.TenLoai</option>
                        }
                    </select>
                    <span asp-validation-for="MaLoai" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaNhanHieu" class="form-label small fw-bold text-dark"></label>
                    <select asp-for="MaNhanHieu" class="form-select rounded-3 py-2" required>
                        <option value="">-- Chọn nhãn hiệu --</option>
                        @foreach (var nh in nhanHieus)
                        {
                            <option value="@nh.MaNhanHieu">@nh.TenNhanHieu</option>
                        }
                    </select>
                    <span asp-validation-for="MaNhanHieu" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaManHinh" class="form-label small fw-bold text-dark"></label>
                    <select asp-for="MaManHinh" class="form-select rounded-3 py-2">
                        <option value="">-- Chọn thông số màn hình --</option>
                        @foreach (var mh in manHinhs)
                        {
                            <option value="@mh.MaManHinh">@mh.TenManHinh</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="ThoiGianBaoHanh" class="form-label small fw-bold text-dark"></label>
                    <div class="input-group">
                        <input asp-for="ThoiGianBaoHanh" type="number" class="form-control rounded-start-3 py-2" placeholder="12" />
                        <span class="input-group-text rounded-end-3">tháng</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="GiaNhap" class="form-label small fw-bold text-dark"></label>
                    <div class="input-group">
                        <input asp-for="GiaNhap" type="number" step="1000" id="txtGiaNhap" class="form-control rounded-start-3 py-2" placeholder="Ví dụ: 20000000" oninput="calculateGiaBan(this.value)" required />
                        <span class="input-group-text rounded-end-3">₫</span>
                    </div>
                    <span asp-validation-for="GiaNhap" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Giá bán tự động (BR-03 = Nhập × 1.10):</label>
                    <div class="form-control bg-light py-2 fw-bolder text-danger fs-5 rounded-3 d-flex align-items-center" id="txtGiaBanPreview">
                        0 ₫
                    </div>
                    <small class="text-secondary">Hệ thống tự động nhân hệ số 1.1 khi lưu vào CSDL</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoLuong" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="SoLuong" type="number" class="form-control rounded-3 py-2" placeholder="Số lượng tồn kho ban đầu" required />
                    <span asp-validation-for="SoLuong" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FileAnh" class="form-label small fw-bold text-dark">🖼️ Tải lên hình ảnh (.jpg, .png &lt; 5MB)</label>
                    <input asp-for="FileAnh" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control rounded-3" />
                </div>

                <div class="col-md-6">
                    <label asp-for="ChupAnh" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="ChupAnh" class="form-control rounded-3 py-2" placeholder="Ví dụ: Chính 48MP, Siêu rộng 12MP..." />
                </div>

                <div class="col-md-6">
                    <label asp-for="AmThanh" class="form-label small fw-bold text-dark"></label>
                    <input asp-for="AmThanh" class="form-control rounded-3 py-2" placeholder="Ví dụ: Loa kép Stereo, Dolby Atmos..." />
                </div>

                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label small fw-bold text-dark"></label>
                    <textarea asp-for="GhiChu" rows="3" class="form-control rounded-3" placeholder="Đặc điểm nổi bật phục vụ tư vấn AI Gemini..."></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="SanPham" class="btn btn-outline-secondary rounded-3 px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Lưu sản phẩm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function calculateGiaBan(giaNhap) {
            const val = parseFloat(giaNhap) || 0;
            const giaBan = Math.round(val * 1.1);
            const el = document.getElementById("txtGiaBanPreview");
            if (el) el.textContent = giaBan.toLocaleString('vi-VN') + " ₫";
        }
        document.addEventListener('DOMContentLoaded', () => {
            const inp = document.getElementById("txtGiaNhap");
            if (inp) calculateGiaBan(inp.value);
        });
    </script>
}
