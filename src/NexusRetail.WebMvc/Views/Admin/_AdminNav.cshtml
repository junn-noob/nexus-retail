@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="bg-white border-bottom shadow-sm mb-4">
    <div class="container py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4 fw-bolder text-dark d-flex align-items-center gap-2">
                <i class="bi bi-shield-shaded text-danger"></i> Duy<b>Mobile</b>
                <span class="badge bg-danger text-white rounded-pill px-2 py-1 small" style="font-size: 11px;">ADMIN PORTAL</span>
            </span>
        </div>

        <nav class="nav nav-pills gap-1 flex-wrap">
            <a asp-action="Index" class="nav-link rounded-3 fw-bold small @(action == "Index" ? "active" : "text-dark bg-light")">
                <i class="bi bi-speedometer2 me-1"></i> Tổng quan
            </a>
            <a asp-action="SanPham" class="nav-link rounded-3 fw-bold small @(action == "SanPham" || action == "ThemSanPham" || action == "SuaSanPham" ? "active" : "text-dark bg-light")">
                <i class="bi bi-phone me-1"></i> Quản lý sản phẩm
            </a>
            <a asp-action="DonHang" class="nav-link rounded-3 fw-bold small @(action == "DonHang" || action == "ChiTietDonHang" ? "active" : "text-dark bg-light")">
                <i class="bi bi-box-seam me-1"></i> Quản lý đơn hàng
            </a>
            <a asp-action="BaoCao" class="nav-link rounded-3 fw-bold small @(action == "BaoCao" ? "active" : "text-dark bg-light")">
                <i class="bi bi-bar-chart-line-fill me-1"></i> 4 Báo cáo BR
            </a>
            <a asp-controller="Home" asp-action="Index" class="nav-link rounded-3 fw-bold small text-primary bg-light border border-dashed border-primary">
                <i class="bi bi-shop me-1"></i> Xem Website
            </a>
        </nav>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="container mb-3">
        <div class="alert alert-success rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 m-0 py-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span class="fw-bold">@TempData["SuccessMessage"]</span>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="container mb-3">
        <div class="alert alert-danger rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 m-0 py-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span class="fw-bold">@TempData["ErrorMessage"]</span>
        </div>
    </div>
}
