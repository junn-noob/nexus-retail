@using System.Text.Json
@model JsonElement?

@{
    ViewData["Title"] = "4 Báo cáo thống kê (Admin)";
    string loai = ViewBag.Loai as string ?? "sp-ban-chay";
    int thang = ViewBag.Thang ?? DateTime.Now.Month;
    int nam = ViewBag.Nam ?? DateTime.Now.Year;
    int quy = ViewBag.Quy ?? 1;
}

<partial name="_AdminNav" />

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-file-earmark-spreadsheet text-primary me-2"></i> 4 Báo cáo thống kê bắt buộc (BR-06 đến BR-09)</h3>
            <small class="text-secondary">Thực thi LINQ Aggregate & Xuất file Excel chuẩn ClosedXML (.xlsx)</small>
        </div>

        <a asp-action="XuatExcel" asp-route-loai="@loai" asp-route-thang="@thang" asp-route-nam="@nam" asp-route-quy="@quy" class="btn btn-success rounded-3 fw-bold px-3 py-2 shadow-sm text-nowrap">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất báo cáo ra Excel (.xlsx)
        </a>
    </div>

    <!-- Filter & Report Selection Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <form method="get" asp-action="BaoCao" class="row g-3 align-items-end">
            <div class="col-lg-5 col-md-12">
                <label class="form-label small fw-bold text-secondary">Chọn loại báo cáo:</label>
                <select name="loai" onchange="this.form.submit()" class="form-select rounded-3 py-2 fw-semibold text-dark">
                    <option value="sp-ban-chay" selected="@(loai == "sp-ban-chay")">BR-06: Top sản phẩm bán chạy nhất (Tháng/Năm)</option>
                    <option value="nhap-lon-nhat-quy" selected="@(loai == "nhap-lon-nhat-quy")">BR-07: Hóa đơn & Tiền nhập lớn nhất theo Quý</option>
                    <option value="doanh-so-nam" selected="@(loai == "doanh-so-nam")">BR-08: Hóa đơn & Tổng doanh số theo Năm</option>
                    <option value="nv-ban-it-nhat" selected="@(loai == "nv-ban-it-nhat")">BR-09: 5 Nhân viên bán ít tiền nhất (Tháng/Năm)</option>
                </select>
            </div>

            @if (loai == "sp-ban-chay" || loai == "nv-ban-it-nhat")
            {
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-bold text-secondary">Tháng:</label>
                    <select name="thang" class="form-select rounded-3 py-2">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(thang == m)">Tháng @m</option>
                        }
                    </select>
                </div>
            }

            @if (loai == "nhap-lon-nhat-quy")
            {
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-bold text-secondary">Quý:</label>
                    <select name="quy" class="form-select rounded-3 py-2">
                        @for (int q = 1; q <= 4; q++)
                        {
                            <option value="@q" selected="@(quy == q)">Quý @q</option>
                        }
                    </select>
                </div>
            }

            <div class="col-md-2 col-6">
                <label class="form-label small fw-bold text-secondary">Năm:</label>
                <select name="nam" class="form-select rounded-3 py-2">
                    @for (int y = DateTime.Now.Year; y >= 2020; y--)
                    {
                        <option value="@y" selected="@(nam == y)">@y</option>
                    }
                </select>
            </div>

            <div class="col-md-2 col-12">
                <button type="submit" class="btn btn-primary rounded-3 fw-bold w-100 py-2 shadow-sm">
                    <i class="bi bi-search me-1"></i> Xem báo cáo
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table View -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
        <div class="table-responsive">
            @if (loai == "sp-ban-chay")
            {
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th class="ps-4">Mã SP</th>
                            <th>Tên sản phẩm</th>
                            <th>Phân loại</th>
                            <th>Nhãn hiệu</th>
                            <th class="text-center">Số lượng đã bán</th>
                            <th class="text-end pe-4">Tổng doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@row.GetProperty("maSp").GetString()</td>
                                    <td class="fw-bold text-dark">@row.GetProperty("tenSp").GetString()</td>
                                    <td><span class="badge bg-light text-dark border">@row.GetProperty("tenLoai").GetString()</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary">@row.GetProperty("tenNhanHieu").GetString()</span></td>
                                    <td class="text-center fw-bold text-success">@row.GetProperty("tongSoLuongBan").GetInt32()</td>
                                    <td class="text-end pe-4 fw-bold text-danger fs-6">@row.GetProperty("tongDoanhThu").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-5 text-secondary">Không có dữ liệu bán hàng trong Tháng @thang/@nam</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (loai == "nhap-lon-nhat-quy")
            {
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th class="ps-4">Mã HĐ Nhập</th>
                            <th>Ngày nhập</th>
                            <th>Nhà cung cấp</th>
                            <th>Nhân viên nhập</th>
                            <th class="text-end pe-4">Tổng tiền nhập</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@row.GetProperty("maHdn").GetString()</td>
                                    <td class="text-secondary small">@row.GetProperty("ngayNhap").GetDateTime().ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-dark">@row.GetProperty("tenNcc").GetString()</td>
                                    <td class="text-secondary">@row.GetProperty("tenNv").GetString()</td>
                                    <td class="text-end pe-4 fw-bold text-danger fs-6">@row.GetProperty("tongTien").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-5 text-secondary">Không tìm thấy hóa đơn nhập nào trong Quý @quy/@nam</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (loai == "doanh-so-nam")
            {
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th class="ps-4">Mã HĐ Bán</th>
                            <th>Ngày bán</th>
                            <th>Khách hàng</th>
                            <th>Nhân viên lập</th>
                            <th class="text-end pe-4">Tổng tiền bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@row.GetProperty("maHdb").GetString()</td>
                                    <td class="text-secondary small">@row.GetProperty("ngayBan").GetDateTime().ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-dark">@row.GetProperty("tenKhach").GetString()</td>
                                    <td class="text-secondary">@row.GetProperty("tenNv").GetString()</td>
                                    <td class="text-end pe-4 fw-bold text-danger fs-6">@row.GetProperty("tongTien").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-5 text-secondary">Không có hóa đơn bán nào trong Năm @nam</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (loai == "nv-ban-it-nhat")
            {
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th class="ps-4">Mã NV</th>
                            <th>Họ và tên nhân viên</th>
                            <th>Giới tính</th>
                            <th>Điện thoại</th>
                            <th class="text-center">Số hóa đơn lập</th>
                            <th class="text-end pe-4">Tổng tiền bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@row.GetProperty("maNv").GetString()</td>
                                    <td class="fw-bold text-dark">@row.GetProperty("tenNv").GetString()</td>
                                    <td><span class="badge bg-light text-dark border">@row.GetProperty("gioiTinh").GetString()</span></td>
                                    <td class="text-primary fw-semibold">@row.GetProperty("dienThoai").GetString()</td>
                                    <td class="text-center fw-bold text-secondary">@row.GetProperty("soHoaDon").GetInt32()</td>
                                    <td class="text-end pe-4 fw-bold text-danger fs-6">@row.GetProperty("tongTienBan").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-5 text-secondary">Không có dữ liệu nhân viên bán hàng trong Tháng @thang/@nam</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
