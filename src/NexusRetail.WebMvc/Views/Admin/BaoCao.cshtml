@using System.Text.Json
@model JsonElement?

@{
    ViewData["Title"] = "4 Báo cáo thống kê (Admin)";
    string loai = ViewBag.Loai as string ?? "sp-ban-chay";
    int thang = ViewBag.Thang ?? DateTime.Now.Month;
    int nam = ViewBag.Nam ?? DateTime.Now.Year;
    int quy = ViewBag.Quy ?? 1;
}

<partial name="_AdminNav" />

<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px 60px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">4 Báo cáo thống kê bắt buộc</h1>
            <p style="color: #64748b; font-size: 13.5px;">Thực thi các quy tắc nghiệp vụ BR-06 đến BR-09 & Xuất file Excel chuẩn ClosedXML.</p>
        </div>

        <a asp-action="XuatExcel" asp-route-loai="@loai" asp-route-thang="@thang" asp-route-nam="@nam" asp-route-quy="@quy" class="btn" style="padding: 10px 18px; font-size: 13.5px; background: #16a34a; border-color: #16a34a; display: flex; align-items: center; gap: 6px;">
            📥 Xuất báo cáo ra Excel (.xlsx)
        </a>
    </div>

    <!-- Filter & Report Selection Bar -->
    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 24px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
        <form method="get" asp-action="BaoCao" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-end;">
            <div style="flex: 2; min-width: 280px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Chọn loại báo cáo:</label>
                <select name="loai" onchange="this.form.submit()" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px; font-weight: 600; color: #0f172a;">
                    <option value="sp-ban-chay" selected="@(loai == "sp-ban-chay")">BR-06: Top sản phẩm bán chạy nhất (Tháng/Năm)</option>
                    <option value="nhap-lon-nhat-quy" selected="@(loai == "nhap-lon-nhat-quy")">BR-07: Hóa đơn & Tiền nhập lớn nhất theo Quý</option>
                    <option value="doanh-so-nam" selected="@(loai == "doanh-so-nam")">BR-08: Hóa đơn & Tổng doanh số theo Năm</option>
                    <option value="nv-ban-it-nhat" selected="@(loai == "nv-ban-it-nhat")">BR-09: 5 Nhân viên bán ít tiền nhất (Tháng/Năm)</option>
                </select>
            </div>

            @if (loai == "sp-ban-chay" || loai == "nv-ban-it-nhat")
            {
                <div style="width: 110px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Tháng:</label>
                    <select name="thang" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(thang == m)">Tháng @m</option>
                        }
                    </select>
                </div>
            }

            @if (loai == "nhap-lon-nhat-quy")
            {
                <div style="width: 120px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Quý:</label>
                    <select name="quy" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px;">
                        @for (int q = 1; q <= 4; q++)
                        {
                            <option value="@q" selected="@(quy == q)">Quý @q</option>
                        }
                    </select>
                </div>
            }

            <div style="width: 120px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Năm:</label>
                <select name="nam" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px;">
                    @for (int y = DateTime.Now.Year; y >= 2020; y--)
                    {
                        <option value="@y" selected="@(nam == y)">@y</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn" style="padding: 9px 18px; font-size: 13.5px;">
                🔍 Xem báo cáo
            </button>
        </form>
    </div>

    <!-- Data Table View -->
    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
        <div style="overflow-x: auto;">
            @if (loai == "sp-ban-chay")
            {
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 600;">
                            <th style="padding: 12px 16px;">Mã SP</th>
                            <th style="padding: 12px 16px;">Tên sản phẩm</th>
                            <th style="padding: 12px 16px;">Phân loại</th>
                            <th style="padding: 12px 16px;">Nhãn hiệu</th>
                            <th style="padding: 12px 16px; text-align: center;">Số lượng đã bán</th>
                            <th style="padding: 12px 16px; text-align: right;">Tổng doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px 16px; font-weight: 600;">@row.GetProperty("maSp").GetString()</td>
                                    <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">@row.GetProperty("tenSp").GetString()</td>
                                    <td style="padding: 12px 16px; color: #475569;">@row.GetProperty("tenLoai").GetString()</td>
                                    <td style="padding: 12px 16px; color: #475569;">@row.GetProperty("tenNhanHieu").GetString()</td>
                                    <td style="padding: 12px 16px; text-align: center; font-weight: 700; color: #16a34a;">@row.GetProperty("tongSoLuongBan").GetInt32()</td>
                                    <td style="padding: 12px 16px; text-align: right; font-weight: 700; color: #dc2626;">@row.GetProperty("tongDoanhThu").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="padding: 30px; text-align: center; color: #64748b;">Không có dữ liệu bán hàng trong Tháng @thang/@nam</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (loai == "nhap-lon-nhat-quy")
            {
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 600;">
                            <th style="padding: 12px 16px;">Mã HĐ Nhập</th>
                            <th style="padding: 12px 16px;">Ngày nhập</th>
                            <th style="padding: 12px 16px;">Nhà cung cấp</th>
                            <th style="padding: 12px 16px;">Nhân viên nhập</th>
                            <th style="padding: 12px 16px; text-align: right;">Tổng tiền nhập</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px 16px; font-weight: 600;">@row.GetProperty("maHdn").GetString()</td>
                                    <td style="padding: 12px 16px; color: #475569;">@row.GetProperty("ngayNhap").GetDateTime().ToString("dd/MM/yyyy")</td>
                                    <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">@row.GetProperty("tenNcc").GetString()</td>
                                    <td style="padding: 12px 16px; color: #475569;">@row.GetProperty("tenNv").GetString()</td>
                                    <td style="padding: 12px 16px; text-align: right; font-weight: 700; color: #dc2626;">@row.GetProperty("tongTien").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="padding: 30px; text-align: center; color: #64748b;">Không có dữ liệu nhập hàng trong Quý @quy/@nam</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (loai == "doanh-so-nam")
            {
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 600;">
                            <th style="padding: 12px 16px;">Mã HĐ Bán</th>
                            <th style="padding: 12px 16px;">Ngày bán</th>
                            <th style="padding: 12px 16px;">Khách hàng</th>
                            <th style="padding: 12px 16px;">Nhân viên bán</th>
                            <th style="padding: 12px 16px; text-align: right;">Doanh số</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px 16px; font-weight: 600;">@row.GetProperty("maHdb").GetString()</td>
                                    <td style="padding: 12px 16px; color: #475569;">@row.GetProperty("ngayBan").GetDateTime().ToString("dd/MM/yyyy")</td>
                                    <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">@row.GetProperty("tenKhach").GetString()</td>
                                    <td style="padding: 12px 16px; color: #475569;">@row.GetProperty("tenNv").GetString()</td>
                                    <td style="padding: 12px 16px; text-align: right; font-weight: 700; color: #dc2626;">@row.GetProperty("tongTien").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="padding: 30px; text-align: center; color: #64748b;">Không có dữ liệu hóa đơn bán trong Năm @nam</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (loai == "nv-ban-it-nhat")
            {
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 600;">
                            <th style="padding: 12px 16px;">Mã NV</th>
                            <th style="padding: 12px 16px;">Họ tên nhân viên</th>
                            <th style="padding: 12px 16px;">Số điện thoại</th>
                            <th style="padding: 12px 16px; text-align: right;">Tổng tiền bán được</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasValue && Model.Value.ValueKind == JsonValueKind.Array && Model.Value.GetArrayLength() > 0)
                        {
                            foreach (var row in Model.Value.EnumerateArray())
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px 16px; font-weight: 600;">@row.GetProperty("maNv").GetString()</td>
                                    <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">@row.GetProperty("tenNv").GetString()</td>
                                    <td style="padding: 12px 16px; color: #475569;">@row.GetProperty("dienThoai").GetString()</td>
                                    <td style="padding: 12px 16px; text-align: right; font-weight: 700; color: #d97706;">@row.GetProperty("tongTienBan").GetDecimal().ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" style="padding: 30px; text-align: center; color: #64748b;">Không có dữ liệu nhân viên trong Tháng @thang/@nam</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
