@using NexusRetail.Shared.DTOs.Common
@using NexusRetail.Shared.DTOs.SanPham
@model PagedResultDto<SanPhamDto>

@{
    ViewData["Title"] = "Quản lý sản phẩm (Admin)";
    int currentPage = ViewBag.CurrentPage ?? 1;
    string query = ViewBag.Query as string ?? "";
}

<partial name="_AdminNav" />

<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px 60px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 14px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">Danh sách sản phẩm</h1>
            <p style="color: #64748b; font-size: 13.5px;">Quản lý kho hàng, cập nhật thông tin cấu hình và ảnh sản phẩm.</p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
            <form method="get" asp-action="SanPham" style="display: flex; gap: 6px;">
                <input type="text" name="q" value="@query" placeholder="Tìm tên/mã SP..." style="padding: 8px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px; width: 220px;" />
                <button type="submit" class="btn ghost" style="padding: 8px 14px; font-size: 13px;">🔍 Tìm</button>
            </form>

            <a asp-action="ThemSanPham" class="btn" style="padding: 8px 16px; font-size: 13.5px; white-space: nowrap;">
                ➕ Thêm sản phẩm mới
            </a>
        </div>
    </div>

    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 600;">
                        <th style="padding: 12px 16px;">Ảnh</th>
                        <th style="padding: 12px 16px;">Mã SP</th>
                        <th style="padding: 12px 16px;">Tên sản phẩm</th>
                        <th style="padding: 12px 16px;">Phân loại</th>
                        <th style="padding: 12px 16px;">Nhãn hiệu</th>
                        <th style="padding: 12px 16px; text-align: right;">Giá bán</th>
                        <th style="padding: 12px 16px; text-align: center;">Tồn kho</th>
                        <th style="padding: 12px 16px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        foreach (var sp in Model.Items)
                        {
                            var imgUrl = string.IsNullOrWhiteSpace(sp.Anh) ? "/img/default.webp" : $"/img/{sp.Anh}";
                            <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='white'">
                                <td style="padding: 10px 16px;">
                                    <img src="@imgUrl" alt="@sp.TenSp" style="width: 44px; height: 44px; object-fit: contain; border-radius: 6px; border: 1px solid #e2e8f0; background: #fafafa;" onerror="this.src='/img/default.webp'" />
                                </td>
                                <td style="padding: 10px 16px; font-weight: 600; color: #1e293b;">@sp.MaSp</td>
                                <td style="padding: 10px 16px; font-weight: 600; color: #0f172a;">
                                    @sp.TenSp
                                    @if (!string.IsNullOrWhiteSpace(sp.GhiChu))
                                    {
                                        <div style="font-size: 11.5px; color: #64748b; font-weight: normal; margin-top: 2px;">@sp.GhiChu</div>
                                    }
                                </td>
                                <td style="padding: 10px 16px; color: #475569;">@sp.TenLoai</td>
                                <td style="padding: 10px 16px; color: #475569;">@sp.TenNhanHieu</td>
                                <td style="padding: 10px 16px; text-align: right; font-weight: 700; color: #dc2626;">
                                    @sp.GiaBan.ToString("N0") ₫
                                </td>
                                <td style="padding: 10px 16px; text-align: center;">
                                    @if (sp.SoLuong > 5)
                                    {
                                        <span style="background: #dcfce7; color: #16a34a; padding: 3px 8px; border-radius: 12px; font-weight: 600; font-size: 12px;">@sp.SoLuong</span>
                                    }
                                    else if (sp.SoLuong > 0)
                                    {
                                        <span style="background: #ffedd5; color: #c2410c; padding: 3px 8px; border-radius: 12px; font-weight: 600; font-size: 12px;">Còn @sp.SoLuong</span>
                                    }
                                    else
                                    {
                                        <span style="background: #fee2e2; color: #dc2626; padding: 3px 8px; border-radius: 12px; font-weight: 600; font-size: 12px;">Hết hàng</span>
                                    }
                                </td>
                                <td style="padding: 10px 16px; text-align: center;">
                                    <div style="display: flex; gap: 6px; justify-content: center;">
                                        <a asp-action="SuaSanPham" asp-route-id="@sp.MaSp" class="btn ghost" style="padding: 4px 10px; font-size: 12px;">
                                            ✏️ Sửa
                                        </a>
                                        <form method="post" asp-action="XoaSanPham" asp-route-id="@sp.MaSp" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm @sp.TenSp (@sp.MaSp)?');" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn ghost" style="padding: 4px 10px; font-size: 12px; color: #dc2626; border-color: #fca5a5;">
                                                🗑️ Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="padding: 30px; text-align: center; color: #64748b;">
                                Không tìm thấy sản phẩm nào phù hợp!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <div style="padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; background: #fafafa; font-size: 13px; color: #64748b;">
                <div>Trang @Model.Page / @Model.TotalPages (Tổng @Model.TotalItems sản phẩm)</div>
                <div style="display: flex; gap: 4px;">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="SanPham" asp-route-page="@(Model.Page - 1)" asp-route-q="@query" class="btn ghost" style="padding: 4px 10px; font-size: 12px;">← Trước</a>
                    }
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <a asp-action="SanPham" asp-route-page="@p" asp-route-q="@query" class="btn ghost" style="padding: 4px 10px; font-size: 12px; @(p == Model.Page ? "background:#1e293b; color:white; border-color:#1e293b;" : "")">@p</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="SanPham" asp-route-page="@(Model.Page + 1)" asp-route-q="@query" class="btn ghost" style="padding: 4px 10px; font-size: 12px;">Sau →</a>
                    }
                </div>
            </div>
        }
    </div>
</div>
