@using NexusRetail.Shared.DTOs.Common
@using NexusRetail.Shared.DTOs.SanPham
@model PagedResultDto<SanPhamDto>

@{
    ViewData["Title"] = "Quản lý sản phẩm (Admin)";
    int currentPage = ViewBag.CurrentPage ?? 1;
    string query = ViewBag.Query as string ?? "";
}

<partial name="_AdminNav" />

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-phone text-primary me-2"></i> Danh sách sản phẩm</h3>
            <small class="text-secondary">Quản lý kho hàng, thông số cấu hình và cập nhật hình ảnh sản phẩm</small>
        </div>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <form method="get" asp-action="SanPham" class="d-flex gap-2">
                <div class="input-group">
                    <input type="text" name="q" value="@query" class="form-control rounded-start-3" placeholder="Tìm theo tên/mã SP..." />
                    <button type="submit" class="btn btn-outline-secondary rounded-end-3">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            <a asp-action="ThemSanPham" class="btn btn-primary rounded-3 fw-bold px-3 shadow-sm text-nowrap">
                <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th class="ps-4">Hình ảnh</th>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Phân loại</th>
                        <th>Nhãn hiệu</th>
                        <th class="text-end">Giá bán</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        foreach (var sp in Model.Items)
                        {
                            var imgUrl = string.IsNullOrWhiteSpace(sp.Anh) ? "/images/products/iphone_16_plus_black_37a9bceca0.png" : $"/images/products/{sp.Anh}";
                            <tr>
                                <td class="ps-4">
                                    <img src="@imgUrl" alt="@sp.TenSp" class="rounded-3 border p-1 bg-white" style="width: 48px; height: 48px; object-fit: contain;" onerror="this.src='/images/products/iphone_16_plus_black_37a9bceca0.png';" />
                                </td>
                                <td class="fw-bold text-dark">@sp.MaSp</td>
                                <td>
                                    <div class="fw-bold text-dark">@sp.TenSp</div>
                                    @if (!string.IsNullOrWhiteSpace(sp.GhiChu))
                                    {
                                        <small class="text-secondary d-block text-truncate" style="max-width: 250px;">@sp.GhiChu</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@sp.TenLoai</span></td>
                                <td><span class="badge bg-primary-subtle text-primary fw-bold">@sp.TenNhanHieu</span></td>
                                <td class="text-end fw-bold text-danger">@sp.GiaBan.ToString("N0") ₫</td>
                                <td class="text-center">
                                    @if (sp.SoLuong > 10)
                                    {
                                        <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">@sp.SoLuong</span>
                                    }
                                    else if (sp.SoLuong > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning fw-bold px-2 py-1">@sp.SoLuong</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-bold px-2 py-1">0 (Hết)</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="SuaSanPham" asp-route-id="@sp.MaSp" class="btn btn-outline-primary" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="XoaSanPham" asp-route-id="@sp.MaSp" class="btn btn-outline-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm @sp.TenSp (@sp.MaSp)?');" title="Xóa">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                Không có sản phẩm nào trong danh sách.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-md justify-content-center gap-1 m-0">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link rounded-3 fw-bold" asp-action="SanPham" asp-route-page="@(currentPage - 1)" asp-route-q="@query">← Trước</a>
                </li>
            }

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link rounded-3 fw-bold" asp-action="SanPham" asp-route-page="@p" asp-route-q="@query">@p</a>
                </li>
            }

            @if (currentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link rounded-3 fw-bold" asp-action="SanPham" asp-route-page="@(currentPage + 1)" asp-route-q="@query">Sau →</a>
                </li>
            }
        </ul>
    }
</div>
