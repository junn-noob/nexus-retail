@model List<NexusRetail.WebMvc.Models.AdminOrderListItem>

@{
    ViewData["Title"] = "Quản lý đơn hàng (Admin)";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<partial name="_AdminNav" />

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-box-seam text-primary me-2"></i> Danh sách đơn hàng bán</h3>
            <small class="text-secondary">Tổng cộng: <strong>@totalItems</strong> hóa đơn bán hàng trên toàn hệ thống</small>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th class="ps-4">Mã HĐ</th>
                        <th>Ngày bán</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Nhân viên</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var ord in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@ord.MaHdb</td>
                                <td class="text-secondary small">@ord.NgayBan.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-dark">@ord.TenKhach</td>
                                <td class="text-primary fw-semibold">@ord.DienThoai</td>
                                <td class="text-secondary">@(string.IsNullOrEmpty(ord.TenNv) ? "Khách Online" : ord.TenNv)</td>
                                <td class="text-end fw-bold text-danger fs-6">
                                    @ord.TongTien.ToString("N0") ₫
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="ChiTietDonHang" asp-route-id="@ord.MaHdb" class="btn btn-sm btn-outline-primary rounded-3 px-3">
                                        <i class="bi bi-eye me-1"></i> Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có đơn hàng nào phát sinh trên hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <ul class="pagination pagination-md justify-content-center gap-1 m-0">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link rounded-3 fw-bold" asp-action="DonHang" asp-route-page="@(currentPage - 1)">← Trước</a>
                </li>
            }

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link rounded-3 fw-bold" asp-action="DonHang" asp-route-page="@p">@p</a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link rounded-3 fw-bold" asp-action="DonHang" asp-route-page="@(currentPage + 1)">Sau →</a>
                </li>
            }
        </ul>
    }
</div>
