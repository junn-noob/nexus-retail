@model List<NexusRetail.WebMvc.Models.AdminOrderListItem>

@{
    ViewData["Title"] = "Quản lý đơn hàng (Admin)";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string query = ViewBag.Query as string ?? "";
}

<partial name="_AdminNav" />

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-box-seam text-primary me-2"></i> Danh sách đơn hàng bán</h3>
            <small class="text-secondary">Tổng cộng: <strong>@totalItems</strong> hóa đơn bán hàng trên toàn hệ thống</small>
        </div>

        <form method="get" asp-action="DonHang" class="d-flex gap-2">
            <input type="text" name="q" value="@query" class="form-control rounded-3" placeholder="Tìm mã HĐ, khách, SĐT, trạng thái..." style="min-width: 260px;" />
            <button type="submit" class="btn btn-primary rounded-3 fw-bold text-nowrap">
                <i class="bi bi-search me-1"></i> Tìm
            </button>
            @if (!string.IsNullOrWhiteSpace(query))
            {
                <a asp-action="DonHang" class="btn btn-outline-secondary rounded-3 text-nowrap">Xóa lọc</a>
            }
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th class="ps-4">Mã HĐ</th>
                        <th>Ngày bán</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Nhân viên</th>
                        <th class="text-center">Thanh toán</th>
                        <th class="text-center">Trạng thái đơn</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var ord in Model)
                        {
                            var orderBadge = ord.TrangThaiDonHang switch
                            {
                                "HoanThanh" => ("bg-success-subtle text-success", "Hoàn thành"),
                                "DangGiao" => ("bg-info-subtle text-info", "Đang giao"),
                                "DaHuy" => ("bg-danger-subtle text-danger", "Đã hủy"),
                                _ => ("bg-warning-subtle text-warning", "Chờ xác nhận")
                            };
                            var payBadge = ord.TrangThaiThanhToan switch
                            {
                                "DaThanhToan" => ("bg-success-subtle text-success", "Đã thanh toán"),
                                "ThanhToanMotPhan" => ("bg-warning-subtle text-warning", "Thanh toán 1 phần"),
                                _ => ("bg-secondary-subtle text-secondary", "Chưa thanh toán")
                            };

                            <tr>
                                <td class="ps-4 fw-bold text-dark">@ord.MaHdb</td>
                                <td class="text-secondary small">@ord.NgayBan.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-dark">@ord.TenKhach</td>
                                <td class="text-primary fw-semibold">@ord.DienThoai</td>
                                <td class="text-secondary">@(string.IsNullOrEmpty(ord.TenNv) ? "Khách Online" : ord.TenNv)</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@DisplayFormatExtensions.FormatPaymentMethod(ord.PhuongThucThanhToan)</span><br />
                                    <span class="badge @payBadge.Item1 mt-1">@payBadge.Item2</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @orderBadge.Item1 px-2 py-1">@orderBadge.Item2</span>
                                </td>
                                <td class="text-end fw-bold text-danger fs-6">
                                    @ord.TongTien.ToString("N0") ₫
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="ChiTietDonHang" asp-route-id="@ord.MaHdb" class="btn btn-sm btn-outline-primary rounded-3 px-3">
                                        <i class="bi bi-eye me-1"></i> Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy đơn hàng nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <ul class="pagination pagination-md justify-content-center gap-1 m-0">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link rounded-3 fw-bold" asp-action="DonHang" asp-route-page="@(currentPage - 1)" asp-route-q="@query">← Trước</a>
                </li>
            }

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link rounded-3 fw-bold" asp-action="DonHang" asp-route-page="@p" asp-route-q="@query">@p</a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link rounded-3 fw-bold" asp-action="DonHang" asp-route-page="@(currentPage + 1)" asp-route-q="@query">Sau →</a>
                </li>
            }
        </ul>
    }
</div>
