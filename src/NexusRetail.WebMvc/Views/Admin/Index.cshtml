@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = isAdmin ? "Trang quản trị (Admin Dashboard)" : "Cổng nghiệp vụ (Staff Portal)";
    int totalProducts = ViewBag.TotalProducts ?? 0;
    int totalOrders = ViewBag.TotalOrders ?? 0;
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    int totalCustomers = ViewBag.TotalCustomers ?? 0;
}

<partial name="_AdminNav" />

<div class="container pb-5">
    <div class="mb-4">
        <h3 class="fw-bold text-dark m-0">
            <i class="bi bi-speedometer2 text-primary me-2"></i>
            @(isAdmin ? "Bảng điều khiển Quản trị viên" : "Bảng điều khiển Nghiệp vụ Bán hàng")
        </h3>
        <small class="text-secondary">
            @(isAdmin
                ? "Chào mừng bạn đến với hệ thống quản trị Duy Mobile. Toàn quyền quản lý danh mục sản phẩm, duyệt đơn hàng và thống kê tài chính."
                : "Khu vực thao tác dành cho Nhân viên: quản lý sản phẩm, xử lý đơn hàng và lập phiếu nhập kho.")
        </small>
    </div>

    <!-- Quick Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-secondary text-uppercase">Tổng số sản phẩm</span>
                    <div class="rounded-3 bg-primary-subtle p-2 text-primary fs-4">
                        <i class="bi bi-phone"></i>
                    </div>
                </div>
                <div class="display-6 fw-bolder text-dark mb-2">@totalProducts</div>
                <a asp-action="SanPham" class="small fw-bold text-primary text-decoration-none mt-auto">
                    Xem danh sách sản phẩm <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-secondary text-uppercase">Tổng số hóa đơn bán</span>
                    <div class="rounded-3 bg-success-subtle p-2 text-success fs-4">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>
                <div class="display-6 fw-bolder text-dark mb-2">@totalOrders</div>
                <a asp-action="DonHang" class="small fw-bold text-success text-decoration-none mt-auto">
                    Xem lịch sử đơn hàng <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary text-uppercase">Doanh thu tích lũy</span>
                        <div class="rounded-3 bg-warning-subtle p-2 text-warning fs-4">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                    </div>
                    <div class="fs-4 fw-bolder text-danger mb-2">@totalRevenue.ToString("N0") ₫</div>
                    <a asp-action="BaoCao" asp-route-loai="doanh-so-nam" class="small fw-bold text-warning text-decoration-none mt-auto">
                        Xem doanh số năm <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary text-uppercase">Báo cáo & Thống kê</span>
                        <div class="rounded-3 bg-danger-subtle p-2 text-danger fs-4">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                        </div>
                    </div>
                    <div class="display-6 fw-bolder text-dark mb-2">5 Báo cáo</div>
                    <a asp-action="BaoCao" class="small fw-bold text-danger text-decoration-none mt-auto">
                        Xem & Xuất file Excel <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary text-uppercase">Nhập kho hàng hóa</span>
                        <div class="rounded-3 bg-info-subtle p-2 text-info fs-4">
                            <i class="bi bi-box-arrow-in-down"></i>
                        </div>
                    </div>
                    <div class="fs-5 fw-bolder text-dark mb-2">Phiếu nhập</div>
                    <a asp-action="NhapHang" class="small fw-bold text-info text-decoration-none mt-auto">
                        Quản lý nhập kho <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary text-uppercase">Thương hiệu phân phối</span>
                        <div class="rounded-3 bg-secondary-subtle p-2 text-secondary fs-4">
                            <i class="bi bi-tags"></i>
                        </div>
                    </div>
                    <div class="fs-5 fw-bolder text-dark mb-2">Nhãn hiệu</div>
                    <a asp-action="NhanHieu" class="small fw-bold text-secondary text-decoration-none mt-auto">
                        Xem nhãn hiệu <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>

    @if (isAdmin)
    {
        <!-- Charts Row (Visual Analytics - Admin Only) -->
        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i> Xu hướng doanh thu 6 tháng gần nhất</h5>
                            <small class="text-secondary">Dữ liệu phân tích doanh số bán lẻ thiết bị di động tại Duy Mobile</small>
                        </div>
                        <span class="badge bg-primary-subtle text-primary py-2 px-3 fw-bold">Dữ liệu thực 6 tháng</span>
                    </div>
                    <div style="height: 250px;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <div class="mb-3">
                        <h5 class="fw-bold text-dark m-0"><i class="bi bi-pie-chart-fill text-warning me-2"></i> Thị phần Nhãn hiệu</h5>
                        <small class="text-secondary">Tỷ trọng doanh số theo thương hiệu</small>
                    </div>
                    <div style="height: 210px;" class="d-flex align-items-center justify-content-center">
                        <canvas id="brandChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Quick Actions Panel -->
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Thao tác nhanh</h5>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ThemSanPham" class="btn btn-primary rounded-3 fw-bold px-3 py-2 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
            </a>
            <a asp-action="SanPham" class="btn btn-outline-secondary rounded-3 fw-bold px-3 py-2">
                <i class="bi bi-phone me-1"></i> Quản lý kho sản phẩm
            </a>
            <a asp-action="DonHang" class="btn btn-outline-secondary rounded-3 fw-bold px-3 py-2">
                <i class="bi bi-box-seam me-1"></i> Kiểm tra hóa đơn khách mua
            </a>
            <a asp-action="TaoHoaDonNhap" class="btn btn-outline-primary rounded-3 fw-bold px-3 py-2">
                <i class="bi bi-box-arrow-in-down me-1"></i> Lập phiếu nhập kho
            </a>
            @if (isAdmin)
            {
                <a asp-action="BaoCao" asp-route-loai="sp-ban-chay" class="btn btn-success rounded-3 fw-bold px-3 py-2 shadow-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel Top sản phẩm bán chạy
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const chartData = @Html.Raw(ViewBag.ChartsJson ?? "{\"monthlyLabels\":[],\"monthlyRevenuesMillions\":[],\"brandLabels\":[],\"brandPercentages\":[]}");

        const revCtx = document.getElementById("revenueChart");
        if (revCtx && typeof Chart !== "undefined") {
            new Chart(revCtx, {
                type: 'line',
                data: {
                    labels: chartData.monthlyLabels || [],
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: chartData.monthlyRevenuesMillions || [],
                        borderColor: '#4f46e5',
                        backgroundColor: 'rgba(79, 70, 229, 0.08)',
                        tension: 0.38,
                        fill: true,
                        pointBackgroundColor: '#4f46e5',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y.toLocaleString('vi-VN') + ' Triệu VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: { callback: v => v + ' tr' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        const brandCtx = document.getElementById("brandChart");
        if (brandCtx && typeof Chart !== "undefined") {
            new Chart(brandCtx, {
                type: 'doughnut',
                data: {
                    labels: chartData.brandLabels || [],
                    datasets: [{
                        data: chartData.brandPercentages || [],
                        backgroundColor: ['#0f172a', '#2563eb', '#f97316', '#64748b'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12 } }
                    },
                    cutout: '70%'
                }
            });
        }
    });
</script>
}
