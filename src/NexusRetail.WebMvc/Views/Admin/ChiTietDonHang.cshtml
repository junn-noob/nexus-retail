@model NexusRetail.WebMvc.Models.AdminOrderDetailViewModel

@{
    ViewData["Title"] = "Chi tiết hóa đơn " + Model.MaHdb;
}

<partial name="_AdminNav" />

<div style="max-width: 900px; margin: 0 auto; padding: 0 20px 60px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">Chi tiết hóa đơn: @Model.MaHdb</h1>
            <p style="color: #64748b; font-size: 13.5px;">Thời gian tạo: @Model.NgayBan.ToString("dd/MM/yyyy HH:mm:ss")</p>
        </div>
        <a asp-action="DonHang" class="btn ghost" style="padding: 8px 14px; font-size: 13px;">← Quay lại danh sách đơn</a>
    </div>

    <!-- Customer & Staff Info Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
            <h3 style="font-size: 15px; font-weight: 700; color: #0f172a; margin-bottom: 12px;">👤 Thông tin khách hàng</h3>
            <div style="font-size: 13.5px; line-height: 1.8; color: #334155;">
                <div><b>Họ tên:</b> @Model.TenKhach</div>
                <div><b>Số điện thoại:</b> <span style="color: #2563eb; font-weight: 600;">@Model.DienThoai</span></div>
            </div>
        </div>

        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
            <h3 style="font-size: 15px; font-weight: 700; color: #0f172a; margin-bottom: 12px;">🏢 Thông tin xử lý</h3>
            <div style="font-size: 13.5px; line-height: 1.8; color: #334155;">
                <div><b>Nhân viên phụ trách:</b> @Model.TenNv</div>
                <div><b>Trạng thái:</b> <span style="background: #dcfce7; color: #16a34a; padding: 3px 8px; border-radius: 10px; font-size: 12px; font-weight: 600;">Đã thanh toán & Xuất kho</span></div>
            </div>
        </div>
    </div>

    <!-- Items List Table -->
    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.02); margin-bottom: 24px;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0; font-weight: 700; font-size: 15px; color: #0f172a;">
            📦 Danh sách mặt hàng
        </div>
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
            <thead>
                <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 600;">
                    <th style="padding: 12px 16px;">Mã SP</th>
                    <th style="padding: 12px 16px;">Tên sản phẩm</th>
                    <th style="padding: 12px 16px; text-align: right;">Đơn giá</th>
                    <th style="padding: 12px 16px; text-align: center;">Số lượng</th>
                    <th style="padding: 12px 16px; text-align: center;">Khuyến mãi</th>
                    <th style="padding: 12px 16px; text-align: right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ChiTiet)
                {
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 12px 16px; font-weight: 600; color: #1e293b;">@item.MaSp</td>
                        <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">@item.TenSp</td>
                        <td style="padding: 12px 16px; text-align: right; color: #475569;">@item.DonGia.ToString("N0") ₫</td>
                        <td style="padding: 12px 16px; text-align: center; font-weight: 600;">@item.SoLuong</td>
                        <td style="padding: 12px 16px; text-align: center; color: #64748b;">@(item.KhuyenMai > 0 ? $"{item.KhuyenMai}%" : "-")</td>
                        <td style="padding: 12px 16px; text-align: right; font-weight: 700; color: #dc2626;">@item.ThanhTien.ToString("N0") ₫</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background: #fafafa; font-size: 15px;">
                    <td colspan="5" style="padding: 16px; text-align: right; font-weight: 700; color: #0f172a;">
                        TỔNG GIÁ TRỊ ĐƠN HÀNG:
                    </td>
                    <td style="padding: 16px; text-align: right; font-weight: 800; color: #dc2626; font-size: 18px;">
                        @Model.TongTien.ToString("N0") ₫
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
