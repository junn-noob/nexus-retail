@model List<NexusRetail.WebMvc.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    var tongTien = Model.Sum(x => x.ThanhTien);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0"><i class="bi bi-cart3 text-primary me-2"></i> Giỏ hàng của bạn</h2>
            <small class="text-secondary">Quản lý các sản phẩm bạn đã chọn mua tại Duy Mobile</small>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-3 fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body py-5">
                <i class="bi bi-cart-x text-secondary display-1 mb-3 d-block"></i>
                <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống!</h4>
                <p class="text-secondary mb-4">Hãy khám phá các siêu phẩm smartphone mới nhất và chọn cho mình sản phẩm ưng ý nhé.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-3 fw-bold px-4 py-2">
                    <i class="bi bi-shop me-1"></i> Khám phá sản phẩm ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Items List -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">Danh sách món hàng (@Model.Sum(x => x.SoLuong) sản phẩm)</span>
                        <form asp-action="Clear" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa toàn bộ sản phẩm khỏi giỏ hàng?');">
                            <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0 fw-semibold">
                                <i class="bi bi-trash3 me-1"></i> Xóa tất cả
                            </button>
                        </form>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle m-0">
                                <thead class="table-light small text-secondary">
                                    <tr>
                                        <th class="ps-4">Sản phẩm</th>
                                        <th class="text-center">Đơn giá</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Thành tiền</th>
                                        <th class="text-center pe-4">Xóa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var imgSrc = Url.Content("~/images/products/" + (string.IsNullOrEmpty(item.Anh) ? "iphone_16_plus_black_37a9bceca0.png" : item.Anh));
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@imgSrc" alt="@item.TenSp" class="rounded-3 border p-1" style="width: 60px; height: 60px; object-fit: contain; background: #fafafa;" onerror="this.src='/images/products/iphone_16_plus_black_37a9bceca0.png';" />
                                                    <div>
                                                        <h6 class="fw-bold text-dark m-0">@item.TenSp</h6>
                                                        <small class="text-secondary">Mã: @item.MaSp</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-semibold text-secondary">
                                                @item.GiaBan.ToString("N0") ₫
                                            </td>
                                            <td class="text-center">
                                                <div class="d-inline-flex align-items-center border rounded-3 overflow-hidden bg-light">
                                                    <form asp-action="UpdateQuantity" method="post" class="m-0">
                                                        <input type="hidden" name="maSp" value="@item.MaSp" />
                                                        <input type="hidden" name="delta" value="-1" />
                                                        <button type="submit" class="btn btn-sm btn-light border-0 fw-bold px-2 py-1">−</button>
                                                    </form>
                                                    <span class="px-2 fw-bold small">@item.SoLuong</span>
                                                    <form asp-action="UpdateQuantity" method="post" class="m-0">
                                                        <input type="hidden" name="maSp" value="@item.MaSp" />
                                                        <input type="hidden" name="delta" value="1" />
                                                        <button type="submit" class="btn btn-sm btn-light border-0 fw-bold px-2 py-1">+</button>
                                                    </form>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold text-danger fs-6">
                                                @item.ThanhTien.ToString("N0") ₫
                                            </td>
                                            <td class="text-center pe-4">
                                                <form asp-action="RemoveItem" method="post" class="m-0">
                                                    <input type="hidden" name="maSp" value="@item.MaSp" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1" title="Xóa">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">Tóm tắt đơn hàng</h5>
                    
                    <div class="d-flex justify-content-between mb-2 text-secondary">
                        <span>Tạm tính (@Model.Sum(x => x.SoLuong) món):</span>
                        <span class="fw-bold text-dark">@tongTien.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-secondary">
                        <span>Phí vận chuyển:</span>
                        <span class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Miễn phí 100%</span>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fw-bold fs-6">Tổng thanh toán:</span>
                        <span class="fw-bolder fs-4 text-danger">@tongTien.ToString("N0") ₫</span>
                    </div>

                    <a asp-action="Checkout" class="btn btn-primary btn-lg rounded-3 fw-bold w-100 py-3 shadow-sm mb-3">
                        Tiến hành đặt hàng <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <div class="p-3 bg-light rounded-3 small text-secondary">
                        <div class="mb-1"><i class="bi bi-shield-check text-success me-1"></i> Bảo hành chính hãng 12 tháng 1 đổi 1</div>
                        <div><i class="bi bi-truck text-primary me-1"></i> Kiểm tra hàng trước khi thanh toán COD</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
