@model NexusRetail.WebMvc.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="wrap" style="max-width: 900px; margin: 30px auto; padding: 0 16px;">
    <div style="margin-bottom: 24px;">
        <a asp-action="Index" class="btn ghost" style="padding: 6px 12px; font-size: 13px;">← Quay lại giỏ hàng</a>
        <h1 style="font-size: 26px; font-weight: 700; color: var(--ink); margin-top: 12px;">📦 Thông tin đặt hàng</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 14px 18px; border-radius: 12px; margin-bottom: 20px;">
            <div asp-validation-summary="All" style="font-size: 14px; font-weight: 500;"></div>
        </div>
    }

    <form asp-action="ProcessCheckout" method="post" style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px;" class="checkout-layout">
        <!-- Cột thông tin nhận hàng -->
        <div style="background: var(--card); border-radius: var(--r); padding: 24px; box-shadow: var(--sh); border: 1px solid var(--line);">
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 20px; color: var(--ink);">1. Thông tin người nhận</h2>

            <div style="margin-bottom: 16px;">
                <label asp-for="TenKhach" style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--ink);">Họ và tên của bạn <span style="color: #ef4444;">*</span></label>
                <input asp-for="TenKhach" placeholder="Ví dụ: Nguyễn Văn A" style="width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line); font-size: 14px;" />
                <span asp-validation-for="TenKhach" style="color: #ef4444; font-size: 12px;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="DienThoai" style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--ink);">Số điện thoại nhận hàng <span style="color: #ef4444;">*</span></label>
                <input asp-for="DienThoai" placeholder="Ví dụ: 0912345678" style="width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line); font-size: 14px;" />
                <span asp-validation-for="DienThoai" style="color: #ef4444; font-size: 12px;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="DiaChi" style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--ink);">Địa chỉ giao hàng chi tiết <span style="color: #ef4444;">*</span></label>
                <textarea asp-for="DiaChi" rows="2" placeholder="Số nhà, ngõ/đường, phường/xã, quận/huyện, tỉnh/thành..." style="width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line); font-size: 14px;"></textarea>
                <span asp-validation-for="DiaChi" style="color: #ef4444; font-size: 12px;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="GhiChu" style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--ink);">Ghi chú thêm (tùy chọn)</label>
                <input asp-for="GhiChu" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao..." style="width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line); font-size: 14px;" />
            </div>

            <h2 style="font-size: 18px; font-weight: 700; margin-top: 24px; margin-bottom: 16px; color: var(--ink);">2. Phương thức thanh toán</h2>
            <div style="border: 2px solid var(--ac); background: var(--soft); border-radius: 12px; padding: 16px; display: flex; align-items: center; gap: 12px;">
                <input type="radio" checked id="cod" name="pttt" style="accent-color: var(--ac); width: 18px; height: 18px;" />
                <label for="cod" style="font-weight: 600; color: var(--ink); cursor: pointer;">
                    💵 Thanh toán khi nhận hàng (COD)
                    <span style="display: block; font-weight: 400; font-size: 12px; color: var(--mute);">Kiểm tra hàng trước khi thanh toán cho shipper</span>
                </label>
            </div>
        </div>

        <!-- Cột tóm tắt đơn hàng -->
        <div style="background: var(--card); border-radius: var(--r); padding: 24px; box-shadow: var(--sh); border: 1px solid var(--line); height: fit-content;">
            <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: var(--ink);">Đơn hàng (@Model.DanhSachMon.Sum(x => x.SoLuong) món)</h3>

            <div style="max-height: 280px; overflow-y: auto; margin-bottom: 16px;">
                @foreach (var item in Model.DanhSachMon)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 14px;">
                        <div style="flex: 1; padding-right: 8px;">
                            <div style="font-weight: 600; color: var(--ink);">@item.TenSp</div>
                            <div style="color: var(--mute); font-size: 12px;">SL: @item.SoLuong × @item.GiaBan.ToString("N0") đ</div>
                        </div>
                        <div style="font-weight: 700; color: var(--ink);">
                            @item.ThanhTien.ToString("N0") đ
                        </div>
                    </div>
                }
            </div>

            <div style="border-top: 1px solid var(--line); padding-top: 14px; margin-bottom: 12px; display: flex; justify-content: space-between; color: var(--mute); font-size: 14px;">
                <span>Vận chuyển</span>
                <span style="font-weight: 600; color: var(--ok);">Miễn phí</span>
            </div>

            <div style="border-top: 1px dashed var(--line); padding-top: 14px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: baseline;">
                <span style="font-size: 16px; font-weight: 600;">Tổng thanh toán</span>
                <span style="font-size: 22px; font-weight: 800; color: var(--ac);">@Model.TongTien.ToString("N0") đ</span>
            </div>

            <button type="submit" class="btn" style="width: 100%; padding: 14px 0; font-size: 16px; font-weight: 700; border-radius: 12px; box-shadow: 0 4px 14px rgba(91, 75, 219, .3);">
                Hoàn tất đặt hàng ✅
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <style>
        @@media (max-width: 768px) {
            .checkout-layout {
                grid-template-columns: 1fr !important;
            }
        }
    </style>
}
