@model NexusRetail.WebMvc.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="container py-4" style="max-width: 1000px;">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3 fw-bold mb-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại giỏ hàng
        </a>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-truck text-primary me-2"></i> Thông tin giao hàng & Thanh toán</h2>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0 mb-4" role="alert">
            <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Vui lòng kiểm tra lại thông tin:</div>
            <div asp-validation-summary="All" class="small"></div>
        </div>
    }

    <form asp-action="ProcessCheckout" method="post" class="row g-4">
        @Html.AntiForgeryToken()
        <!-- Delivery info -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
                <h5 class="fw-bold text-dark mb-3">1. Thông tin người nhận hàng</h5>

                <div class="mb-3">
                    <label asp-for="TenKhach" class="form-label small fw-bold text-dark">Họ và tên người nhận <span class="text-danger">*</span></label>
                    <input asp-for="TenKhach" class="form-control rounded-3 py-2" placeholder="Ví dụ: Nguyễn Văn A" required />
                    <span asp-validation-for="TenKhach" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DienThoai" class="form-label small fw-bold text-dark">Số điện thoại nhận hàng <span class="text-danger">*</span></label>
                    <input asp-for="DienThoai" type="tel" class="form-control rounded-3 py-2" placeholder="Ví dụ: 0912345678" required />
                    <span asp-validation-for="DienThoai" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiaChi" class="form-label small fw-bold text-dark">Địa chỉ nhận hàng chi tiết <span class="text-danger">*</span></label>
                    <textarea asp-for="DiaChi" class="form-control rounded-3" rows="3" placeholder="Số nhà, ngõ/đường, phường/xã, quận/huyện, tỉnh/thành..." required></textarea>
                    <span asp-validation-for="DiaChi" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GhiChu" class="form-label small fw-bold text-dark">Ghi chú giao hàng (Tùy chọn)</label>
                    <input asp-for="GhiChu" class="form-control rounded-3 py-2" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao 15 phút..." />
                </div>
            </div>

            <!-- Payment Method -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3">2. Phương thức thanh toán</h5>
                
                <div class="p-3 border border-2 border-primary rounded-3 bg-primary-subtle d-flex align-items-center gap-3">
                    <input class="form-check-input mt-0 fs-5" type="radio" checked id="codPayment" name="paymentOption" />
                    <label class="form-check-label text-dark fw-bold" for="codPayment">
                        💵 Thanh toán khi nhận hàng (COD)
                        <span class="d-block text-secondary small fw-normal">Kiểm tra sản phẩm nguyên seal trước khi thanh toán cho shipper</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Order Summary side -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                <h5 class="fw-bold text-dark mb-3">Đơn hàng của bạn (@Model.DanhSachMon.Sum(x => x.SoLuong) món)</h5>

                <div class="d-flex flex-column gap-2 mb-3" style="max-height: 260px; overflow-y: auto;">
                    @foreach (var item in Model.DanhSachMon)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                            <div class="pe-2">
                                <div class="fw-bold small text-dark">@item.TenSp</div>
                                <small class="text-secondary">SL: @item.SoLuong × @item.GiaBan.ToString("N0") ₫</small>
                            </div>
                            <div class="fw-bold text-danger small text-nowrap">
                                @item.ThanhTien.ToString("N0") ₫
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between mb-2 text-secondary small">
                    <span>Phí vận chuyển:</span>
                    <span class="text-success fw-bold">Miễn phí 100%</span>
                </div>

                <hr class="my-2">

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fw-bold text-dark">Tổng cộng:</span>
                    <span class="fw-bolder fs-4 text-danger">@Model.TongTien.ToString("N0") ₫</span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold w-100 py-3 shadow">
                    <i class="bi bi-check-circle-fill me-1"></i> Hoàn tất đặt hàng
                </button>

                <div class="text-center mt-3 small text-secondary">
                    <i class="bi bi-shield-lock text-success me-1"></i> Thông tin thanh toán an toàn & bảo mật
                </div>
            </div>
        </div>
    </form>
</div>
