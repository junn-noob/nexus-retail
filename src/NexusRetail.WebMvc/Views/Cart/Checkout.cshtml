@model NexusRetail.WebMvc.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="page-wrap">
    <div class="page-header">
        <a asp-action="Index" class="btn ghost" style="font-size:13px;">← Quay lại giỏ hàng</a>
        <h1>📦 Thông tin đặt hàng</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-error">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-action="ProcessCheckout" method="post" class="checkout-layout">
        <div class="co-info-panel">
            <h2 class="co-section-title">1. Thông tin người nhận</h2>

            <div class="co-field">
                <label asp-for="TenKhach">Họ và tên <span class="required">*</span></label>
                <input asp-for="TenKhach" placeholder="Ví dụ: Nguyễn Văn A" />
                <span asp-validation-for="TenKhach" class="field-error"></span>
            </div>

            <div class="co-field">
                <label asp-for="DienThoai">Số điện thoại nhận hàng <span class="required">*</span></label>
                <input asp-for="DienThoai" placeholder="Ví dụ: 0912 345 678" />
                <span asp-validation-for="DienThoai" class="field-error"></span>
            </div>

            <div class="co-field">
                <label asp-for="DiaChi">Địa chỉ giao hàng <span class="required">*</span></label>
                <textarea asp-for="DiaChi" rows="2" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành..."></textarea>
                <span asp-validation-for="DiaChi" class="field-error"></span>
            </div>

            <div class="co-field">
                <label asp-for="GhiChu">Ghi chú (tùy chọn)</label>
                <input asp-for="GhiChu" placeholder="Ví dụ: Giao giờ hành chính, gọi trước 30 phút..." />
            </div>

            <h2 class="co-section-title" style="margin-top:28px;">2. Phương thức thanh toán</h2>
            <div class="payment-option selected">
                <input type="radio" checked id="cod" name="pttt" />
                <label for="cod">
                    <span style="font-size:20px;">💵</span>
                    <div>
                        <div style="font-weight:700;">Thanh toán khi nhận hàng (COD)</div>
                        <div style="font-size:12px; color:var(--mute); margin-top:2px;">Kiểm tra hàng trước khi thanh toán cho shipper</div>
                    </div>
                </label>
            </div>
        </div>

        <div class="co-summary-panel">
            <h3>Đơn hàng (@Model.DanhSachMon.Sum(x => x.SoLuong) món)</h3>
            <div class="co-items">
                @foreach (var item in Model.DanhSachMon)
                {
                    <div class="co-item">
                        <div class="co-item-img" style="background-image:url('@Url.Content("~/images/products/" + (item.Anh ?? "default.jpg"))')"></div>
                        <div style="flex:1; min-width:0;">
                            <div class="co-item-name">@item.TenSp</div>
                            <div style="color:var(--mute); font-size:12px;">SL: @item.SoLuong × @item.GiaBan.ToString("N0") đ</div>
                        </div>
                        <div class="co-item-price">@item.ThanhTien.ToString("N0") đ</div>
                    </div>
                }
            </div>

            <div class="co-summary-row">
                <span>Vận chuyển</span>
                <span style="color:var(--ok); font-weight:600;">Miễn phí</span>
            </div>
            <div class="co-summary-total">
                <span>Tổng thanh toán</span>
                <span class="co-total-val">@Model.TongTien.ToString("N0") đ</span>
            </div>
            <button type="submit" class="btn co-submit-btn">Hoàn tất đặt hàng ✅</button>
            <div style="text-align:center; font-size:12px; color:var(--mute); margin-top:12px; line-height:1.6;">
                🔒 Thông tin được bảo mật tuyệt đối
            </div>
        </div>
    </form>
</div>

@section Scripts {
<style>
    .page-wrap { max-width: 980px; margin: 32px auto 80px; padding: 0 20px; }
    .page-header { display:flex; align-items:center; gap:16px; margin-bottom:28px; }
    .page-header h1 { font-size:24px; font-weight:800; letter-spacing:-.5px; }
    .alert-error { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; padding:14px 18px; border-radius:12px; margin-bottom:20px; font-size:14px; }
    .checkout-layout { display:grid; grid-template-columns:1.5fr 1fr; gap:24px; align-items:start; }
    .co-info-panel, .co-summary-panel { background:var(--card); border-radius:var(--r); padding:28px; box-shadow:var(--sh); border:1px solid var(--line); }
    .co-section-title { font-size:17px; font-weight:700; margin-bottom:20px; padding-bottom:12px; border-bottom:1px solid var(--line); }
    .co-field { display:flex; flex-direction:column; gap:6px; margin-bottom:16px; }
    .co-field label { font-size:13px; font-weight:600; color:var(--ink); }
    .co-field input, .co-field textarea { padding:12px 14px; border-radius:10px; border:1.5px solid var(--line); font-size:14px; background:var(--bg); outline:none; transition:border-color .2s, box-shadow .2s; font-family:inherit; resize:none; }
    .co-field input:focus, .co-field textarea:focus { border-color:var(--ac); background:#fff; box-shadow:0 0 0 4px var(--soft); }
    .required { color:#ef4444; }
    .field-error { color:#ef4444; font-size:12px; }
    .payment-option { border:2px solid var(--line); border-radius:12px; padding:14px 16px; transition:border-color .2s; }
    .payment-option.selected { border-color:var(--ac); background:var(--soft); }
    .payment-option label { display:flex; align-items:center; gap:12px; cursor:pointer; }
    .payment-option input { accent-color:var(--ac); width:18px; height:18px; }
    .co-summary-panel h3 { font-size:17px; font-weight:700; margin-bottom:16px; }
    .co-items { display:flex; flex-direction:column; gap:12px; max-height:280px; overflow-y:auto; margin-bottom:16px; padding-right:2px; }
    .co-item { display:flex; gap:10px; align-items:center; }
    .co-item-img { width:48px; height:48px; border-radius:8px; background:#f0f0f5 center/contain no-repeat; border:1px solid var(--line); flex-shrink:0; }
    .co-item-name { font-size:13px; font-weight:600; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .co-item-price { font-size:13px; font-weight:700; color:var(--ink); white-space:nowrap; }
    .co-summary-row { display:flex; justify-content:space-between; font-size:14px; color:var(--mute); border-top:1px solid var(--line); padding-top:12px; margin-bottom:10px; }
    .co-summary-total { display:flex; justify-content:space-between; align-items:baseline; border-top:1px dashed var(--line); padding-top:14px; margin-bottom:20px; }
    .co-summary-total span:first-child { font-size:15px; font-weight:600; }
    .co-total-val { font-size:22px; font-weight:800; color:var(--ac); }
    .co-submit-btn { display:block; width:100%; padding:14px; font-size:15px; font-weight:700; border-radius:12px; text-align:center; box-shadow:0 4px 14px rgba(91,75,219,.3); }
    @@media (max-width: 768px) { .checkout-layout { grid-template-columns:1fr; } }
</style>
}
